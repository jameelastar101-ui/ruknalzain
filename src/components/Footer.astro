---
/**
 * Footer.astro — sitewide NAP block, click-to-contact actions and link columns.
 * NAP string must stay identical to BaseLayout schema and the contact page
 * (CLAUDE.md §4: NAP uniformity).
 */
import { getCollection, getEntries } from 'astro:content';

const year = new Date().getFullYear();

/** Every product, grouped in the same category / order as the hub YAML and the
 *  header nav, flattened to a flat name -> path list for the Shop column.
 *  Kept in sync with the /shop index — Zain Linkmats is excluded there (data
 *  pending) so it's excluded here too. */
const hubOrder = [
  '/acoustic-soundproofing-flooring',
  '/gym-fitness-flooring',
  '/animal-agricultural-flooring',
];
const EXCLUDED_PRODUCT_PATHS = new Set(['/outdoor-pavers/linkmats']);
const hubs = await getCollection('hubs');
const shopLinks = (
  await Promise.all(
    hubOrder.map(async (path) => {
      const hub = hubs.find((h) => h.data.path === path);
      return hub ? getEntries(hub.data.children) : [];
    }),
  )
)
  .flat()
  .filter((p) => !EXCLUDED_PRODUCT_PATHS.has(p.data.path))
  .map((p) => ({ label: p.data.h1.split(' — ')[0], href: p.data.path }));

const productLinks = [
  { label: 'Acoustic & soundproofing flooring', href: '/acoustic-soundproofing-flooring' },
  { label: 'Gym & fitness rubber flooring', href: '/gym-fitness-flooring' },
  { label: 'Gym safety accessories', href: '/gym-safety-accessories' },
  { label: 'Animal & agricultural rubber flooring', href: '/animal-agricultural-flooring' },
];

const companyLinks = [
  { label: 'About Rukn Al Zain', href: '/about-us' },
  { label: 'Projects', href: '/projects-gallery' },
  { label: 'Resources & guides', href: '/blog' },
  { label: 'Contact & quote', href: '/contact' },
];

const linkClass =
  'rounded hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400';
---
<footer class="bg-charcoal-800 text-industrial-200">
  <div class="mx-auto max-w-content px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      {/* NAP + click-to-contact */}
      <div class="lg:col-span-2">
        <div class="inline-flex items-center gap-2.5">
          <span class="grid h-9 w-9 place-items-center rounded bg-amber-400 font-heading text-lg font-extrabold leading-none text-charcoal-900">
            RZ
          </span>
          <span class="font-heading text-base font-bold uppercase tracking-[0.14em] text-white">
            Rukn Al Zain
          </span>
        </div>

        <address class="mt-4 not-italic leading-relaxed">
          <span class="block font-medium text-white">Rukn Al Zain General Trading LLC</span>
          P.O. Box 36528, Dubai, UAE<br />
          Phone:
          <a href="tel:+971505698195" class={linkClass}>+971505698195</a>
        </address>

        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="tel:+971505698195"
            class="inline-flex items-center gap-2 rounded border border-white/15 px-3 py-2 text-sm hover:border-white/35 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" />
            </svg>
            Call
          </a>
          <a
            href="https://wa.me/971505698195"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded bg-amber-400 px-3 py-2 text-sm font-semibold text-charcoal-900 hover:bg-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal-800"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.611-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.075-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.825 9.825 0 016.988 2.898 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892a11.86 11.86 0 001.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.463 3.488" />
            </svg>
            WhatsApp
          </a>
        </div>

        <p class="mt-5 max-w-md text-sm text-industrial-300">
          Supplier of heavy-duty recycled-rubber flooring across all seven emirates —
          Dubai, Abu Dhabi, Sharjah, Ajman, Ras Al Khaimah, Umm Al Quwain and Fujairah.
        </p>
      </div>

      {/* Products */}
      <nav aria-label="Products">
        <h2 class="font-heading text-sm font-semibold uppercase tracking-wider text-white">Products</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            productLinks.map((l) => (
              <li>
                <a href={l.href} class={linkClass}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Company */}
      <nav aria-label="Company">
        <h2 class="font-heading text-sm font-semibold uppercase tracking-wider text-white">Company</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            companyLinks.map((l) => (
              <li>
                <a href={l.href} class={linkClass}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {/* Shop — every product */}
    <nav aria-label="Shop" class="mt-12 border-t border-white/10 pt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="font-heading text-sm font-semibold uppercase tracking-wider text-white">Shop</h2>
        <a href="/shop" class={linkClass}>All products &rarr;</a>
      </div>
      <ul class="mt-4 grid gap-x-6 gap-y-2.5 text-sm sm:grid-cols-2 lg:grid-cols-3">
        {
          shopLinks.map((l) => (
            <li>
              <a href={l.href} class={linkClass}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="mt-12 border-t border-white/10 pt-6 text-sm text-industrial-300">
      &copy; {year} Rukn Al Zain General Trading LLC. All rights reserved.
    </p>
  </div>
</footer>
