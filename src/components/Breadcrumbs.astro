---
/**
 * Breadcrumbs.astro — visible breadcrumb trail + BreadcrumbList JSON-LD
 * (CLAUDE.md §5). The final crumb is the current page and carries no link.
 */
export interface Crumb {
  name: string;
  href?: string;
}
export interface Props {
  trail: Crumb[];
}

const { trail } = Astro.props;
const origin = (Astro.site ?? new URL('https://ruknalzain.ae')).origin;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(c.href ? { item: `${origin}${c.href}` } : {}),
  })),
};
---
<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-charcoal-500">
    {
      trail.map((c, i) => (
        <li class="flex items-center gap-x-2">
          {i > 0 && <span aria-hidden="true" class="text-charcoal-300">/</span>}
          {c.href ? (
            <a
              href={c.href}
              class="rounded hover:text-amber-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
            >
              {c.name}
            </a>
          ) : (
            <span aria-current="page" class="font-medium text-charcoal">
              {c.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
