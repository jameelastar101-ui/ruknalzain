---
/**
 * SpecTable.astro — GEO requirement: technical specifications in a real <table>.
 *
 * The brief's spec tables are collection targets, not data (CLAUDE.md §0), so we
 * never invent figures. Rows with no confirmed `value` render a uniform
 * "TBD — <spec>, e.g. XX <unit>" placeholder so the table still reads as a
 * complete layout, and each still emits a `<!-- TODO: Missing spec -->` comment.
 */
export interface SpecRow {
  label: string;
  value?: string | null;
  unit?: string;
}
export interface Props {
  specs: SpecRow[];
  productName: string;
  caption?: string;
}

const { specs, productName, caption } = Astro.props;
const missing = specs.filter((s) => !s.value).map((s) => s.label);
const allMissing = specs.length > 0 && missing.length === specs.length;
const todoComment = `<!-- TODO: Missing spec — ${productName}: ${missing.join(', ') || 'none'} -->`;

/** Uniform placeholder text for a row with no confirmed value. */
const placeholder = (s: SpecRow) =>
  s.unit ? `${s.label}, e.g. XX ${s.unit}` : `${s.label} — value to be provided`;
---
<figure class="overflow-x-auto">
  <table class="w-full border-collapse text-left text-sm">
    <caption class="mb-3 text-left font-heading text-base font-semibold text-charcoal">
      {caption ?? `${productName} — technical specifications`}
    </caption>
    <thead>
      <tr class="border-b-2 border-charcoal-300 bg-industrial-100">
        <th scope="col" class="px-4 py-2.5 font-semibold text-charcoal">Specification</th>
        <th scope="col" class="px-4 py-2.5 font-semibold text-charcoal">Detail</th>
      </tr>
    </thead>
    <tbody>
      {
        specs.map((s, i) => (
          <tr class:list={['border-b border-industrial-300', i % 2 === 1 && 'bg-industrial-100']}>
            <th scope="row" class="px-4 py-2.5 align-top font-medium text-charcoal">
              {s.label}
            </th>
            <td class="px-4 py-2.5 align-top tabular-nums text-charcoal-600">
              {s.value ? (
                <span>{s.unit ? `${s.value} ${s.unit}` : s.value}</span>
              ) : (
                <span class="inline-flex flex-wrap items-baseline gap-x-2">
                  <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wide text-amber-800">
                    TBD
                  </span>
                  <span class="not-italic text-charcoal-400">{placeholder(s)}</span>
                </span>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {missing.length > 0 && <Fragment set:html={todoComment} />}

  {
    missing.length > 0 && (
      <figcaption class="mt-3 rounded border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-charcoal-700">
        {allMissing
          ? 'Values shown are placeholders — full technical specifications for this product are being confirmed with the manufacturer. '
          : 'Some values shown are placeholders and are being confirmed. '}
        <a
          href="/contact"
          class="font-semibold text-amber-700 underline hover:text-amber-800"
        >
          Request the technical data sheet
        </a>
        .
      </figcaption>
    )
  }
</figure>
