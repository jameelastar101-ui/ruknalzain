    {/* ─── SUBTLE MOTION ──────────────────────────────────────────────────────
        One-shot CSS load-in for the hero and a staggered scroll-reveal for
        headings, card groups, figures and the spec table. Progressive
        enhancement only — content is fully visible without JS, and every effect
        is disabled under prefers-reduced-motion. Mirrors rubber-gym-tiles.astro. */}
    <style is:global>
      .zf-js .zf-page [data-hero] {
        animation: zf-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes zf-rise {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
      }

      .zf-js .zf-page [data-reveal],
      .zf-js .zf-page [data-reveal-group] > * {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .zf-js .zf-page [data-reveal].in,
      .zf-js .zf-page [data-reveal-group].in > * {
        opacity: 1;
        transform: none;
      }
      .zf-js .zf-page [data-reveal-group].in > *:nth-child(2) { transition-delay: 0.06s; }
      .zf-js .zf-page [data-reveal-group].in > *:nth-child(3) { transition-delay: 0.12s; }
      .zf-js .zf-page [data-reveal-group].in > *:nth-child(4) { transition-delay: 0.18s; }
      .zf-js .zf-page [data-reveal-group].in > *:nth-child(5) { transition-delay: 0.24s; }
      .zf-js .zf-page [data-reveal-group].in > *:nth-child(n + 6) { transition-delay: 0.3s; }

      .zf-page .card-lift {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      .zf-page .card-lift:hover {
        transform: translateY(-3px);
      }

      @media (prefers-reduced-motion: reduce) {
        .zf-js .zf-page [data-hero] {
          animation: none;
        }
        .zf-js .zf-page [data-reveal],
        .zf-js .zf-page [data-reveal-group] > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .zf-page .card-lift,
        .zf-page .card-lift:hover {
          transition: none;
          transform: none;
        }
      }
    </style>

    <script>
      const targets = document.querySelectorAll(
        '.zf-page [data-reveal], .zf-page [data-reveal-group]',
      );
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealAll = () => targets.forEach((el) => el.classList.add('in'));

      if (reduce || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
        window.addEventListener('load', () => setTimeout(revealAll, 1200));
      }
    </script>
