  ogImage={OG_IMG}
  ogImageAlt="ZainFit easy-install interlocking rubber gym tiles by Rukn Al Zain, Dubai UAE."
>
  <article class="zf-page">
    {/*
      Mark the document as JS-capable ASAP so scroll-reveal elements start hidden
      only when the animation engine is available. A failsafe timer guarantees
      content becomes visible even if the observer below never runs, and
      reduced-motion visitors skip the effect entirely.
    */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('zf-js');
        var sel = '.zf-page [data-reveal], .zf-page [data-reveal-group]';
        var showAll = function () {
          document.querySelectorAll(sel).forEach(function (el) {
            el.classList.add('in');
          });
        };
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', showAll);
          else showAll();
        } else {
          setTimeout(showAll, 1600);
        }
      })();
    </script>

    {/* Breadcrumb strip — Home > Gym & Fitness Flooring > Rubber Gym Tiles > ZainFit */}
    <div class="border-b border-industrial-300 bg-industrial-100">
      <div class={`${container} py-4`}>
        <Breadcrumbs
          trail={[
            { name: 'Home', href: '/' },
            { name: 'Gym & Fitness Flooring', href: '/gym-fitness-flooring' },
            { name: 'Rubber Gym Tiles', href: '/rubber-gym-tiles' },
