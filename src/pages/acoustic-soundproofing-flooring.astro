                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      class="h-6 w-6"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M16.023 9.348h4.992V4.356M3.985 15.653H8.977v4.992M4.031 9.75a8.25 8.25 0 0 1 13.803-3.7L21 9m-1.031 5.25a8.25 8.25 0 0 1-13.803 3.7L3 15"
                      />
                    </svg>
                  )}
                </span>
                <dt class="font-heading font-semibold text-charcoal">{it.term}</dt>
                <dd class="mt-1.5 text-sm text-charcoal-600">{it.desc}</dd>
              </div>
