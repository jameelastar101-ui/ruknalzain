/**
 * AEO: FAQPage JSON-LD only. Organization is emitted sitewide by BaseLayout and
 * the BreadcrumbList by Breadcrumbs.astro, so the redesign brief's combined
 * @graph is trimmed here to just the FAQ node to avoid duplicate schema types.
 * mainEntity is 1:1 with the visible accordion; answers stay in the DOM (native
 * <details> collapse, not removed) so they remain extractable.
 */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const sectionShell = 'border-t border-industrial-300 py-14 sm:py-16';
const container = 'mx-auto max-w-content px-4 sm:px-6 lg:px-8';
const h2 = 'text-2xl font-bold text-charcoal';
const lede = 'mt-4 max-w-3xl text-charcoal-600';
const primaryCta =
  'inline-flex items-center justify-center rounded bg-amber-400 px-5 py-3 font-semibold text-charcoal-900 transition-colors hover:bg-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2';
---

<BaseLayout
  title="Acoustic Underlay & Soundproof Flooring Dubai | Rukn Al Zain"
  description="High-density rubber acoustic underlayments and screed isolation systems engineered for high-rises and commercial developments across Dubai and the UAE."
  canonical="/acoustic-soundproofing-flooring"
  ogImage={HERO_IMG}
  ogImageAlt={HERO_ALT}
>
  <article>
    {/* Breadcrumb strip */}
    <div class="border-b border-industrial-300 bg-industrial-100">
      <div class={`${container} py-4`}>
        <Breadcrumbs trail={[{ name: 'Home', href: '/' }, { name: 'Acoustic Flooring' }]} />
      </div>
    </div>

    {/* Hero */}
    <header class="bg-charcoal-700 text-white">
      <div class={`${container} py-14 sm:py-16`}>
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div>
            <h1 class="text-4xl font-extrabold leading-tight text-white sm:text-5xl">
              Acoustic &amp; Soundproofing Flooring Solutions in Dubai
            </h1>

            {/* AEO direct-answer block */}
            <p
              class="mt-5 max-w-xl border-l-[3px] border-amber-400 pl-4 text-lg text-industrial-100"
            >
              Stop unwanted noise in your building projects. Rukn Al Zain supplies
              high-performance rubber acoustic underlays, screed isolation mats, and perimeter
              strips across Dubai.
            </p>
            <p class="mt-4 max-w-xl text-industrial-200">
              Our products cut down impact noise from footsteps, moving furniture, and heavy
              equipment. Whether you are building residential towers in Dubai Marina or fitting
              out commercial offices in Business Bay, we provide reliable soundproofing made
              from recycled materials.
            </p>

            <div class="mt-7 flex flex-wrap gap-3">
              <a href="#request-quote" class={`${primaryCta} focus-visible:ring-offset-charcoal-700`}>
                Request Specification Sheet
              </a>
              <a
                href="https://wa.me/971505698195"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center rounded border border-white/25 px-5 py-3 font-semibold text-white transition-colors hover:border-white/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
              >
                Chat on WhatsApp
              </a>
            </div>
          </div>

          <figure class="m-0">
            <img
              src={HERO_IMG}
              alt={HERO_ALT}
              title="Recycled rubber acoustic underlay installation on a Dubai high-rise concrete slab"
              width="1376"
              height="768"
              fetchpriority="high"
              decoding="async"
              class="h-auto w-full rounded border border-white/10"
            />
            <figcaption class="mt-2 text-sm text-industrial-300">
              High-performance recycled rubber acoustic underlay laid across concrete slabs in a
              Dubai high-rise project.
            </figcaption>
          </figure>
        </div>
      </div>
    </header>

    {/* Trusted Local Supply Across Dubai (authored H3 -> promoted to H2) */}
    <section aria-labelledby="trusted-supply-h" class={`${sectionShell} bg-white`}>
      <div class={container}>
        <h2 id="trusted-supply-h" class={h2}>Trusted Local Supply Across Dubai</h2>
        <dl class="mt-8 grid gap-5 sm:grid-cols-3">
          {
            trustedSupply.map((it) => (
              <div class="rounded border border-industrial-300 border-l-[3px] border-l-amber-400 bg-industrial-100 p-5">
                <span
                  class="mb-3 grid h-11 w-11 place-items-center rounded bg-white text-amber-700 ring-1 ring-industrial-300"
                  aria-hidden="true"
                >
                  {it.icon === 'shield' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      class="h-6 w-6"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 12.75 11.25 15 15 9.75M12 3l7.5 3v5.25c0 4.28-2.96 8.29-7.5 9.75-4.54-1.46-7.5-5.47-7.5-9.75V6L12 3z"
                      />
                    </svg>
                  )}
                  {it.icon === 'truck' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      class="h-6 w-6"
