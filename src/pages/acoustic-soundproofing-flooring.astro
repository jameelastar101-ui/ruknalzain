                  src={s.img.src}
                  alt={s.img.alt}
                  title={s.img.title}
                  width="1376"
                  height="768"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/9] w-full border-b border-industrial-300 object-cover"
                />
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="font-heading text-lg font-bold text-charcoal">{s.name}</h3>
                  <dl class="mt-3 space-y-2.5 text-sm">
                    {s.rows.map(([k, v]) => (
