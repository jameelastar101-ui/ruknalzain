                <label>Leave this field empty if you are human: <input name="bot-field" /></label>
              </p>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label class={labelClass} for="name">
                    Full Name <span class="text-amber-700">*</span>
                  </label>
                  <input
                    class={fieldClass}
                    type="text"
                    id="name"
                    name="name"
                    autocomplete="name"
                    required
                  />
                </div>
                <div>
                  <label class={labelClass} for="email">
                    Email <span class="text-amber-700">*</span>
                  </label>
                  <input
                    class={fieldClass}
                    type="email"
                    id="email"
                    name="email"
                    autocomplete="email"
                    required
                  />
                </div>
                <div>
                  <label class={labelClass} for="phone">
                    Phone / WhatsApp <span class="text-amber-700">*</span>
                  </label>
                  <input
                    class={fieldClass}
                    type="tel"
                    id="phone"
                    name="phone"
                    autocomplete="tel"
                    inputmode="tel"
                    required
                  />
                </div>
                <div>
                  <label class={labelClass} for="location">Project Location / Emirate</label>
                  <select class={fieldClass} id="location" name="location">
                    <option value="" selected disabled>Select an emirate</option>
                    {emirates.map((e) => <option value={e}>{e}</option>)}
                  </select>
                </div>
                <div>
                  <label class={labelClass} for="coverage">Coverage Area (m²)</label>
                  <input
                    class={fieldClass}
                    type="number"
                    id="coverage"
                    name="coverage"
                    min="0"
                    step="1"
                    inputmode="numeric"
                    placeholder="e.g. 120"
                  />
                </div>
              </div>

              <div>
                <label class={labelClass} for="message">Message</label>
                <textarea
                  class={fieldClass}
                  id="message"
                  name="message"
                  rows="4"
                  placeholder="Tell us about your facility — number of stalls, animal type, subfloor, thickness needed, timeline"
                ></textarea>
              </div>

              <div class="flex flex-wrap gap-3">
                <button
                  type="submit"
                  class="inline-flex items-center justify-center rounded bg-amber-400 px-5 py-3 font-semibold text-charcoal-900 transition-colors hover:bg-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2"
                >
                  Request Free Sample &amp; Quote
                </button>
                <a
                  href={WHATSAPP_PLAIN}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center justify-center rounded border border-charcoal-300 px-5 py-3 font-semibold text-charcoal transition-colors hover:border-charcoal-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
                >
                  Chat on WhatsApp (+971 50 569 8195)
                </a>
              </div>
              <p class="text-xs text-charcoal-400">
                Submissions are handled by Netlify Forms on the live site.
              </p>
            </form>
          </div>
          </div>
        </div>
      </div>
    </section>

    <script is:inline>
      // Progressive enhancement only: reveals the success banner in place of
      // the quote form when the Netlify form redirect lands back here with
      // ?submitted (static output has no server adapter, so this can't be a
      // build/render-time check — see src/pages/contact.astro for the same
      // pattern and the fuller explanation).
      if (new URLSearchParams(window.location.search).has('submitted')) {
        document.getElementById('quote-success')?.classList.remove('hidden');
        document.getElementById('quote-form-panel')?.classList.add('hidden');
      }
    </script>

    {/* ─── SUBTLE MOTION ──────────────────────────────────────────────────────
        One-shot CSS load-in for the hero and a staggered scroll-reveal for
        headings, card groups, figures and the spec table. Progressive
        enhancement only — content is fully visible without JS, and every effect
        is disabled under prefers-reduced-motion. Mirrors hammer-top.astro. */}
    <style is:global>
      .hm-js .hm-page [data-hero] {
        animation: hm-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes hm-rise {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
      }

      .hm-js .hm-page [data-reveal],
      .hm-js .hm-page [data-reveal-group] > * {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .hm-js .hm-page [data-reveal].in,
      .hm-js .hm-page [data-reveal-group].in > * {
        opacity: 1;
        transform: none;
      }
      .hm-js .hm-page [data-reveal-group].in > *:nth-child(2) { transition-delay: 0.06s; }
      .hm-js .hm-page [data-reveal-group].in > *:nth-child(3) { transition-delay: 0.12s; }
      .hm-js .hm-page [data-reveal-group].in > *:nth-child(4) { transition-delay: 0.18s; }
      .hm-js .hm-page [data-reveal-group].in > *:nth-child(5) { transition-delay: 0.24s; }
      .hm-js .hm-page [data-reveal-group].in > *:nth-child(n + 6) { transition-delay: 0.3s; }

      .hm-page .card-lift {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      .hm-page .card-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px -6px rgb(42 45 52 / 0.18);
      }

      @media (prefers-reduced-motion: reduce) {
        .hm-js .hm-page [data-hero] {
          animation: none;
        }
        .hm-js .hm-page [data-reveal],
        .hm-js .hm-page [data-reveal-group] > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .hm-page .card-lift,
        .hm-page .card-lift:hover {
          transition: none;
          transform: none;
        }
      }
    </style>

    <script>
      const targets = document.querySelectorAll(
        '.hm-page [data-reveal], .hm-page [data-reveal-group]',
      );
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealAll = () => targets.forEach((el) => el.classList.add('in'));

      if (reduce || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
        window.addEventListener('load', () => setTimeout(revealAll, 1200));
      }
    </script>
  </article>
</BaseLayout>
