    {/* ─── SUBTLE MOTION ──────────────────────────────────────────────────────
        A one-shot load-in for the hero (pure CSS, cannot get stuck hidden) and a
        staggered scroll-reveal (fade + short rise) for headings, card groups,
        figures, the spec table and the FAQ. Plus a small hover lift on cards.
        Progressive enhancement only — content is fully visible without JS, and
        every effect is disabled under prefers-reduced-motion. */}
    <style is:global>
      .gfr-js .gfr-page [data-hero] {
        animation: gfr-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes gfr-rise {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
      }

      .gfr-js .gfr-page [data-reveal],
      .gfr-js .gfr-page [data-reveal-group] > * {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .gfr-js .gfr-page [data-reveal].in,
      .gfr-js .gfr-page [data-reveal-group].in > * {
        opacity: 1;
        transform: none;
      }
      .gfr-js .gfr-page [data-reveal-group].in > *:nth-child(2) { transition-delay: 0.06s; }
      .gfr-js .gfr-page [data-reveal-group].in > *:nth-child(3) { transition-delay: 0.12s; }
      .gfr-js .gfr-page [data-reveal-group].in > *:nth-child(4) { transition-delay: 0.18s; }
      .gfr-js .gfr-page [data-reveal-group].in > *:nth-child(5) { transition-delay: 0.24s; }
      .gfr-js .gfr-page [data-reveal-group].in > *:nth-child(6) { transition-delay: 0.30s; }
      .gfr-js .gfr-page [data-reveal-group].in > *:nth-child(n + 7) { transition-delay: 0.36s; }

      .gfr-page .card-lift {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      .gfr-page .card-lift:hover {
        transform: translateY(-3px);
      }

      @media (prefers-reduced-motion: reduce) {
        .gfr-js .gfr-page [data-hero] {
          animation: none;
        }
        .gfr-js .gfr-page [data-reveal],
        .gfr-js .gfr-page [data-reveal-group] > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .gfr-page .card-lift,
        .gfr-page .card-lift:hover {
          transition: none;
          transform: none;
        }
      }
    </style>

    <script>
      const targets = document.querySelectorAll(
        '.gfr-page [data-reveal], .gfr-page [data-reveal-group]',
      );
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealAll = () => targets.forEach((el) => el.classList.add('in'));

      if (reduce || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
        window.addEventListener('load', () => setTimeout(revealAll, 1200));
      }
    </script>
