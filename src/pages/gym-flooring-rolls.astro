  ogImage={HERO_IMG}
  ogImageAlt={HERO_ALT}
>
  <article class="gfr-page">
    {/*
      Set a marker class ASAP so scroll-reveal elements start hidden only when JS
      is running (no-JS visitors always get fully rendered content). A failsafe
      timer guarantees everything becomes visible even if the observer module
      below never executes, and reduced-motion users skip the effect entirely.
    */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('gfr-js');
        var sel = '.gfr-page [data-reveal], .gfr-page [data-reveal-group]';
        var showAll = function () {
          document.querySelectorAll(sel).forEach(function (el) {
            el.classList.add('in');
          });
        };
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', showAll);
          else showAll();
        } else {
          // Failsafe: never leave content hidden if the observer never runs.
          setTimeout(showAll, 1600);
        }
      })();
    </script>

