    </section>

    <script is:inline>
      // Progressive enhancement only: reveals the success banner in place of
      // the quote form when the Netlify form redirect lands back here with
      // ?submitted (static output has no server adapter, so this can't be a
      // build/render-time check — see src/pages/contact.astro for the same
      // pattern and the fuller explanation).
      if (new URLSearchParams(window.location.search).has('submitted')) {
        document.getElementById('quote-success')?.classList.remove('hidden');
        document.getElementById('quote-form-panel')?.classList.add('hidden');
      }
    </script>

    {/* ─── SUBTLE MOTION ──────────────────────────────────────────────────────
        One-shot CSS load-in for the hero and a staggered scroll-reveal for
        headings, card groups, figures and the spec table. Progressive
        enhancement only — content is fully visible without JS, and every effect
        is disabled under prefers-reduced-motion. Mirrors zainduo.astro. */}
    <style is:global>
      .zcs-js .zcs-page [data-hero] {
        animation: zcs-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes zcs-rise {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
      }

      .zcs-js .zcs-page [data-reveal],
      .zcs-js .zcs-page [data-reveal-group] > * {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .zcs-js .zcs-page [data-reveal].in,
      .zcs-js .zcs-page [data-reveal-group].in > * {
        opacity: 1;
        transform: none;
      }
      .zcs-js .zcs-page [data-reveal-group].in > *:nth-child(2) { transition-delay: 0.06s; }
      .zcs-js .zcs-page [data-reveal-group].in > *:nth-child(3) { transition-delay: 0.12s; }
      .zcs-js .zcs-page [data-reveal-group].in > *:nth-child(4) { transition-delay: 0.18s; }
      .zcs-js .zcs-page [data-reveal-group].in > *:nth-child(5) { transition-delay: 0.24s; }
      .zcs-js .zcs-page [data-reveal-group].in > *:nth-child(n + 6) { transition-delay: 0.3s; }

      .zcs-page .card-lift {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      .zcs-page .card-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px -6px rgb(42 45 52 / 0.18);
      }

      @media (prefers-reduced-motion: reduce) {
        .zcs-js .zcs-page [data-hero] {
          animation: none;
        }
        .zcs-js .zcs-page [data-reveal],
        .zcs-js .zcs-page [data-reveal-group] > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .zcs-page .card-lift,
        .zcs-page .card-lift:hover {
          transition: none;
          transform: none;
        }
      }
    </style>

    <script>
      const targets = document.querySelectorAll(
        '.zcs-page [data-reveal], .zcs-page [data-reveal-group]',
      );
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealAll = () => targets.forEach((el) => el.classList.add('in'));

      if (reduce || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
        window.addEventListener('load', () => setTimeout(revealAll, 1200));
      }
    </script>
  </article>
</BaseLayout>
