---
/**
 * /blog — "Resources & guides" index. Brief §5 "/blog/".
 * Lists every published post from the `posts` collection, newest first.
 * Individual articles render via src/pages/blog/[slug].astro.
 */
import { getCollection } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft && !data.noindex)).sort(
  (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf(),
);

const fmtDate = (dt: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(dt);
---

<BaseLayout
  title="Rubber Flooring & Acoustic Insulation Guides | Rukn Al Zain Blog"
  description="Buying guides, comparisons and technical resources on acoustic underlay, gym flooring and stable matting for the UAE market."
  canonical="/blog"
>
  <PageHero
    title="Resources & guides"
    lede="Buying guides, comparisons and technical explainers on acoustic underlay, gym flooring and stable matting for the UAE market — written for specifiers and buyers who need to make a decision."
    trail={[{ name: 'Home', href: '/' }, { name: 'Resources & guides' }]}
  />

  <div class="mx-auto max-w-content px-4 py-14 sm:px-6 lg:px-8">
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        posts.map((post) => (
          <li>
            <article class="flex h-full flex-col rounded border border-industrial-300 bg-white p-6 transition-shadow hover:shadow-lift">
              <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">
                {post.data.topic}
              </p>
              <h2 class="mt-2 font-heading text-lg font-bold text-charcoal">
                <a
                  href={`/blog/${post.id}`}
                  class="rounded hover:text-amber-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
                >
                  {post.data.h1}
                </a>
              </h2>
              <p class="mt-3 flex-1 text-sm text-charcoal-600">{post.data.excerpt}</p>
              <p class="mt-4 text-xs text-charcoal-500">
                <time datetime={post.data.datePublished.toISOString().slice(0, 10)}>
                  {fmtDate(post.data.datePublished)}
                </time>
                <span aria-hidden="true" class="mx-2 text-industrial-400">/</span>
                {post.data.readMinutes} min read
              </p>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 rounded border border-industrial-300 bg-industrial-100 p-6">
      <p class="max-w-2xl text-charcoal-700">
        Need an answer before you have read every guide?{' '}
        <a href="/contact" class="font-semibold text-amber-700 underline hover:text-amber-800">
          Ask us directly
        </a>{' '}
        or browse the{' '}
        <a
          href="/acoustic-soundproofing-flooring"
          class="font-semibold text-amber-700 underline hover:text-amber-800"
        >
          product FAQs
        </a>
        .
      </p>
    </div>
  </div>
</BaseLayout>
