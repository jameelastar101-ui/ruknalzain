---
/**
 * /blog/[slug] — resources / guide article renderer.
 *
 * Content lives in src/content/posts/*.md (the `posts` collection, schema in
 * src/content/config.ts). Layout mirrors the house system: light breadcrumb
 * strip, charcoal hero with the single <h1> + lede byline, a scoped `.prose-rz`
 * article body, an optional self-contained FAQ block, a "related products"
 * rail and a charcoal bottom CTA band.
 *
 * Structured data:
 *  - BreadcrumbList  → emitted by <Breadcrumbs />
 *  - FAQPage         → emitted by <Faq /> (only when the post supplies faqs)
 *  - BlogPosting     → emitted inline below
 * Organization JSON-LD is emitted sitewide by BaseLayout.
 *
 * Editorial rule (CLAUDE.md §0 "Data Integrity"): posts must not invent Rukn Al
 * Zain product specs — thicknesses, densities, tested STC/IIC figures. General
 * industry/standards context is fine; product numbers stay on the product pages
 * once confirmed.
 */
import { getCollection, render } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Faq from '@components/Faq.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const PATH = `/blog/${entry.id}`;
const SITE = (Astro.site ?? new URL('https://ruknalzain.ae')).origin;

const published = d.datePublished;
const modified = d.dateModified ?? d.datePublished;
const dateLabel = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(published);

/* Related products / hubs by segment — keyword-rich internal links (CLAUDE.md
   §3 consistent terminology, §1 internal linking). */
const relatedByTopic: Record<string, { label: string; href: string }[]> = {
  Acoustic: [
    { label: 'Acoustic & Soundproofing Flooring', href: '/acoustic-soundproofing-flooring' },
    { label: 'ZainAcoustic Underlay', href: '/acoustic-underlay' },
    { label: 'ZainSilence Screed Isolation', href: '/screed-isolation' },
    { label: 'Zain Acoustic Strip', href: '/acoustic-strips' },
  ],
  'Gym & fitness': [
    { label: 'Gym & Fitness Rubber Flooring', href: '/gym-fitness-flooring' },
    { label: 'Rubber Gym Tiles', href: '/rubber-gym-tiles' },
    { label: 'Gym Flooring Rolls', href: '/gym-flooring-rolls' },
    { label: 'Zain Curb Stone', href: '/gym-safety-accessories/curb-stone' },
  ],
  'Animal & agricultural': [
    { label: 'Animal & Agricultural Rubber Flooring', href: '/animal-agricultural-flooring' },
    { label: 'Zain Horse Mats', href: '/horse-mats' },
    { label: 'Zain Hammer Top', href: '/hammer-top' },
    { label: 'ZainPavers Dog Bone', href: '/outdoor-pavers/dogbone' },
  ],
  Sustainability: [
    { label: 'Acoustic & Soundproofing Flooring', href: '/acoustic-soundproofing-flooring' },
    { label: 'Gym & Fitness Rubber Flooring', href: '/gym-fitness-flooring' },
    { label: 'Animal & Agricultural Rubber Flooring', href: '/animal-agricultural-flooring' },
    { label: 'About Rukn Al Zain', href: '/about-us' },
  ],
};
const related = relatedByTopic[d.topic] ?? [];

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${SITE}${PATH}#article`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE}${PATH}` },
  headline: d.h1,
  description: d.metaDescription,
  inLanguage: 'en-AE',
  datePublished: published.toISOString().slice(0, 10),
  dateModified: modified.toISOString().slice(0, 10),
  image: `${SITE}/logo.jpg`,
  author: {
    '@type': 'Organization',
    name: 'Rukn Al Zain General Trading LLC',
    url: `${SITE}/`,
  },
  publisher: { '@id': `${SITE}/#organization` },
  about: d.primaryKeyword,
  keywords: [d.primaryKeyword, ...d.secondaryKeywords].join(', '),
  articleSection: d.topic,
  isAccessibleForFree: true,
};

const container = 'mx-auto max-w-content px-4 sm:px-6 lg:px-8';
const crumbLink =
  'rounded hover:text-amber-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700';
---

<BaseLayout
  title={d.seoTitle}
  description={d.metaDescription}
  canonical={PATH}
  ogType="article"
  noindex={d.noindex}
>
  <div class="border-b border-industrial-300 bg-industrial-100">
    <div class={`${container} py-4`}>
      <Breadcrumbs
        trail={[
          { name: 'Home', href: '/' },
          { name: 'Resources & guides', href: '/blog' },
          { name: d.h1 },
        ]}
      />
    </div>
  </div>

  <article>
    <header class="bg-charcoal-700 text-white">
      <div class={`${container} py-14 sm:py-16`}>
        <p class="font-heading text-sm font-semibold uppercase tracking-wide text-amber-400">
          {d.topic}
        </p>
        <h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-tight text-white sm:text-[2.75rem]">
          {d.h1}
        </h1>
        <p class="mt-5 max-w-2xl border-l-[3px] border-amber-400 pl-4 text-lg text-industrial-100">
          {d.excerpt}
        </p>
        <p class="mt-6 text-sm text-industrial-300">
          By Rukn Al Zain
          <span aria-hidden="true" class="mx-2 text-charcoal-300">/</span>
          <time datetime={published.toISOString().slice(0, 10)}>{dateLabel}</time>
          <span aria-hidden="true" class="mx-2 text-charcoal-300">/</span>
          {d.readMinutes} min read
        </p>
      </div>
    </header>

    <div class="bg-white py-14 sm:py-16">
      <div class={container}>
        <div class="prose-rz max-w-3xl">
          <Content />
        </div>

        {
          related.length > 0 && (
            <aside
              aria-labelledby="related-h"
              class="mt-14 max-w-3xl rounded border border-industrial-300 border-l-[3px] border-l-amber-400 bg-industrial-100 p-6"
            >
              <h2 id="related-h" class="font-heading text-base font-bold text-charcoal">
                Related products
              </h2>
              <ul class="mt-4 grid gap-x-6 gap-y-2.5 text-sm sm:grid-cols-2">
                {related.map((r) => (
                  <li>
                    <a
                      href={r.href}
                      class="rounded font-semibold text-amber-700 hover:text-amber-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
                    >
                      {r.label}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>
    </div>

    {d.faqs && d.faqs.length > 0 && <Faq faqs={d.faqs} id="post-faq" />}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(blogPostingSchema)}
    />

    <section aria-labelledby="cta-h" class="border-t border-industrial-300 bg-charcoal-700 text-white">
      <div class={`${container} py-14`}>
        <h2 id="cta-h" class="text-2xl font-bold text-white">
          Need a recommendation for your project?
        </h2>
        <p class="mt-4 max-w-2xl text-industrial-200">
          Tell our Dubai team the surface, the space and the result you need. We will point
          you to the right product, send technical datasheets and quote for delivery across
          all seven emirates.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded bg-amber-400 px-5 py-3 font-semibold text-charcoal-900 transition-colors hover:bg-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal-700"
          >
            Request a Quote
          </a>
          <a
            href="https://wa.me/971505698195"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center rounded border border-white/25 px-5 py-3 font-semibold text-white transition-colors hover:border-white/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal-700"
          >
            WhatsApp Now
          </a>
        </div>
        <p class="mt-8 text-sm text-industrial-300">
          <a href="/blog" class="rounded font-semibold text-amber-400 hover:text-amber-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400">
            &larr; All resources &amp; guides
          </a>
        </p>
      </div>
    </section>
  </article>

  {/* Scoped article typography — no @tailwindcss/typography dependency. Tracks
      the brand tokens: Montserrat headings, Inter body, amber-700 links, the
      3px amber "spec rule" on blockquotes, zebra-striped bordered tables. */}
  <style is:global>
    .prose-rz {
      color: theme('colors.charcoal.600');
      font-size: 1.0625rem;
      line-height: 1.75;
    }
    .prose-rz > * + * {
      margin-top: 1.25rem;
    }
    .prose-rz h2 {
      margin-top: 2.75rem;
      margin-bottom: 1rem;
      font-family: theme('fontFamily.heading');
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.25;
      color: theme('colors.charcoal.700');
    }
    .prose-rz h3 {
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      font-family: theme('fontFamily.heading');
      font-size: 1.175rem;
      font-weight: 700;
      color: theme('colors.charcoal.700');
    }
    .prose-rz h2 + h3 {
      margin-top: 1.25rem;
    }
    .prose-rz a {
      font-weight: 600;
      color: theme('colors.amber.700');
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .prose-rz a:hover {
      color: theme('colors.amber.800');
    }
    .prose-rz strong {
      font-weight: 700;
      color: theme('colors.charcoal.700');
    }
    .prose-rz figure {
      margin: 2rem 0;
    }
    .prose-rz figure svg {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid theme('colors.industrial.300');
      border-radius: theme('borderRadius.DEFAULT');
      background: #fff;
    }
    .prose-rz figcaption {
      margin-top: 0.65rem;
      font-size: 0.85rem;
      line-height: 1.55;
      color: theme('colors.charcoal.500');
    }
    .prose-rz ul,
    .prose-rz ol {
      padding-left: 1.5rem;
    }
    .prose-rz ul {
      list-style: disc;
    }
    .prose-rz ol {
      list-style: decimal;
    }
    .prose-rz li {
      margin-top: 0.5rem;
    }
    .prose-rz li::marker {
      color: theme('colors.charcoal.400');
    }
    .prose-rz blockquote {
      border-left: 3px solid theme('colors.amber.400');
      padding-left: 1rem;
      font-style: normal;
      color: theme('colors.charcoal.700');
    }
    .prose-rz code {
      background: theme('colors.industrial.200');
      border-radius: 0.25rem;
      padding: 0.1rem 0.35rem;
      font-size: 0.9em;
    }
    .prose-rz hr {
      border: 0;
      border-top: 1px solid theme('colors.industrial.300');
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }
    .prose-rz table {
      display: block;
      width: 100%;
      overflow-x: auto;
      border-collapse: collapse;
      font-size: 0.95rem;
      font-variant-numeric: tabular-nums;
    }
    .prose-rz th,
    .prose-rz td {
      border: 1px solid theme('colors.industrial.300');
      padding: 0.625rem 0.875rem;
      text-align: left;
      vertical-align: top;
    }
    .prose-rz thead th {
      background: theme('colors.charcoal.700');
      color: #fff;
      font-family: theme('fontFamily.heading');
    }
    .prose-rz tbody tr:nth-child(even) {
      background: theme('colors.industrial.100');
    }
    .prose-rz :target {
      scroll-margin-top: 6rem;
    }
  </style>
</BaseLayout>
