<BaseLayout
  title="Rubber Gym Flooring UAE | Tiles, Rolls & Fitness Flooring | Rukn Al Zain"
  description="Durable rubber gym flooring for commercial gyms, home gyms, and fitness studios across the UAE — tiles, rolls, and Duo Performance systems."
  canonical="/gym-fitness-flooring"
  ogImage={HERO_IMG}
  ogImageAlt={HERO_ALT}
>
  <article>
    {/* Breadcrumb strip — emits BreadcrumbList JSON-LD */}
    <div class="border-b border-industrial-300 bg-industrial-100">
      <div class={`${container} py-4`}>
        <Breadcrumbs trail={[{ name: 'Home', href: '/' }, { name: 'Gym & Fitness Flooring' }]} />
      </div>
    </div>

    {/* ─── 1. HERO ─────────────────────────────────────────────────────────── */}
    <header class="bg-charcoal-700 text-white">
      <div class={`${container} py-14 sm:py-16`}>
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div>
            <h1 class="text-4xl font-extrabold leading-tight text-white sm:text-5xl">
              Commercial &amp; Home Gym Flooring Supplier in Dubai, UAE
            </h1>

            {/* AEO direct-answer block */}
            <p class="mt-5 max-w-xl border-l-[3px] border-amber-400 pl-4 text-lg text-industrial-100">
              Gym flooring is a shock-absorbing recycled-rubber surface — supplied as interlocking
              tiles, continuous rolls or a combined roll-and-tile system — that protects the
              subfloor, cushions dropped weights and reduces noise.
            </p>

            <p class="mt-4 max-w-xl text-industrial-200">
              Rukn Al Zain supplies high-density recycled SBR and EPDM rubber gym flooring designed
              for commercial fitness centers, CrossFit boxes, and home studios across all seven
              Emirates. Available in 15 mm to 40 mm tiles and continuous rolls with certified shock
              absorption and thermal durability built for the GCC climate.
            </p>

            <div class="mt-7 flex flex-wrap gap-3">
              <a href="#request-quote" class={`${primaryCta} focus-visible:ring-offset-charcoal-700`}>
                Request Free Material Samples
              </a>
              <a
                href="https://wa.me/971505698195"
                target="_blank"
                rel="noopener"
                class={`${ghostCta} focus-visible:ring-offset-charcoal-700`}
              >
                Chat on WhatsApp
              </a>
            </div>
          </div>

          <figure class="m-0">
            <img
              src={HERO_IMG}
              alt={HERO_ALT}
              title="High-density rubber gym flooring in a commercial fitness facility in Dubai, UAE"
              width="1408"
              height="768"
              fetchpriority="high"
              decoding="async"
              class="h-auto w-full rounded border border-white/10"
            />
            <figcaption class="mt-2 text-sm text-industrial-300">
              High-density recycled-rubber gym flooring installed across a commercial fitness
              facility in Dubai.
            </figcaption>
          </figure>
        </div>
      </div>
    </header>

    {/* ─── 2. TRUST & COMPLIANCE BAR ──────────────────────────────────────── */}
