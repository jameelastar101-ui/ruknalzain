  description="Heavy-duty screed isolation matting in Dubai. Superior impact sound dampening under wet screed construction for commercial and residential developments."
  canonical={PATH}
  ogImage={OG_IMG}
  ogImageAlt="ZainSilence high-load recycled crumb-rubber screed isolation matting by Rukn Al Zain, Dubai UAE."
>
  <article class="zs-page">
    {/*
      Mark the document as JS-capable ASAP so scroll-reveal elements start hidden
      only when the animation engine is available. A failsafe timer guarantees
      content becomes visible even if the observer below never runs, and
      reduced-motion visitors skip the effect entirely.
    */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('zs-js');
        var sel = '.zs-page [data-reveal], .zs-page [data-reveal-group]';
        var showAll = function () {
          document.querySelectorAll(sel).forEach(function (el) {
            el.classList.add('in');
          });
        };
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', showAll);
          else showAll();
        } else {
          setTimeout(showAll, 1600);
        }
      })();
    </script>

