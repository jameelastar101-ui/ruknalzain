---
/**
 * /shop — a single index of every product across all three categories, with a
 * zero-JS category filter.
 *
 * ROUTING: does not collide with src/pages/[...slug].astro — no hub or product
 * entry owns the `/shop` path.
 *
 * FILTER: a CSS-only "checkbox hack" — four visually-hidden radio inputs
 * (`name="shop-filter"`) drive which category `<section>`s are shown via sibling
 * combinators in the `is:global` style block below. "All products" is checked by
 * default, so every product is in the DOM and visible without JS or CSS support
 * (progressive enhancement; good for crawlers). Real radios keep arrow-key
 * navigation and label-click behaviour for free.
 *
 * Cards mirror the hub "Products in this range" grid (HubPage.astro). Category
 * order and product order both follow the hub YAML `children` arrays, matching
 * the header nav and footer.
 *
 * Category placeholder images are reused here (astro:assets <Image />).
 * TODO: Missing spec from brief — swap the three category placeholders for real
 * per-product photography.
 */
import { getCollection, getEntries } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';

import acousticImg from '@assets/placeholders/acoustic.jpg';
import gymImg from '@assets/placeholders/gym.jpg';
import animalImg from '@assets/placeholders/animal.jpg';

const images = { acoustic: acousticImg, gym: gymImg, animal: animalImg };

const hubOrder = [
  '/acoustic-soundproofing-flooring',
  '/gym-fitness-flooring',
  '/animal-agricultural-flooring',
];

/**
 * Products kept off the Shop index. They still have their own page and appear on
 * their category hub — they're just not merchandised here.
 * Zain Linkmats (`/outdoor-pavers/linkmats`) is data-pending: no confirmed specs
 * or product photo yet.
 */
const EXCLUDED_PATHS = new Set(['/outdoor-pavers/linkmats']);

const hubs = await getCollection('hubs');
const groups = await Promise.all(
  hubOrder.map(async (path) => {
    const hub = hubs.find((h) => h.data.path === path)!;
    const products = (await getEntries(hub.data.children)).filter(
      (p) => !EXCLUDED_PATHS.has(p.data.path),
    );
    return { hub, products };
  }),
);

/** "Zain Acoustic Underlay — Premium Soundproofing…" -> "Zain Acoustic Underlay" */
const productName = (h1: string) => h1.split(' — ')[0];

/**
 * Per-product card photography, keyed by canonical product path. These live in
 * public/ so they're referenced with a plain <img> (astro:assets <Image /> only
 * optimises src/assets). Any product missing here falls back to the category
 * placeholder (defensive — every product currently on the index has a photo).
 * TODO: Missing spec from brief — swap these for a real, consistent product
 * shoot before go-live.
 */
const productImages: Record<string, string> = {
  '/acoustic-underlay':
    '/images/acoustic-soundproofing-flooring/zainacoustic-underlayment-roll.jpg',
  '/sports-track-underlay':
    '/images/acoustic-soundproofing-flooring/zainprime-sports-track-underlayment.jpg',
  '/screed-isolation':
    '/images/acoustic-soundproofing-flooring/zainsilence-screed-matting.jpg',
  '/acoustic-strips':
    '/images/acoustic-soundproofing-flooring/zain-acoustic-perimeter-strip.jpg',
  '/rubber-gym-tiles/zainfit':
    '/images/gym-fitness-flooring/zainfit-interlocking-rubber-tiles.jpg',
  '/rubber-gym-tiles/zainsquare':
    '/images/gym-fitness-flooring/zainsquare-recycled-rubber-tiles.jpg',
  '/rubber-gym-tiles/zainextreme':
    '/images/gym-fitness-flooring/zainextreme-heavy-duty-gym-tiles.jpg',
  '/gym-flooring-rolls/zainduo':
    '/images/gym-flooring-rolls/zainduo-hero-product.jpg',
  '/gym-flooring-rolls/zainactive-rolls':
    '/images/gym-fitness-flooring/zainactive-rubber-flooring-rolls.jpg',
  '/gym-safety-accessories/curb-stone':
    '/images/gym-fitness-flooring/zain-curb-stone-gym-barrier.jpg',
  '/horse-mats':
    '/images/animal-agricultural-flooring/zain-horse-mats-stable-flooring.jpg',
  '/hammer-top':
    '/images/animal-agricultural-flooring/zain-hammer-top-rubber-mats.jpg',
  '/outdoor-pavers/dogbone':
    '/images/animal-agricultural-flooring/zainpavers-dog-bone-rubber-pavers.jpg',
  '/outdoor-pavers/hexagon':
    '/images/animal-agricultural-flooring/zain-hexagon-rubber-pavers.jpg',
};

const allProducts = groups.flatMap((g) => g.products);
const totalProducts = allProducts.length;

/** Filter chips: an "All" pill plus one per category, each with a live count. */
const filters = [
  { id: 'shop-all', key: 'all', label: 'All products', count: totalProducts },
  ...groups.map((g) => ({
    id: `shop-${g.hub.id}`,
    key: g.hub.id,
    label: g.hub.data.navLabel,
    count: g.products.length,
  })),
];

const SITE = (Astro.site ?? new URL('https://ruknalzain.ae')).origin;

/** ItemList JSON-LD for the full product index (no price asserted). */
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Rukn Al Zain rubber flooring products',
  numberOfItems: totalProducts,
  itemListElement: allProducts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: productName(p.data.h1),
    url: `${SITE}${p.data.path}`,
  })),
};

const container = 'mx-auto max-w-content px-4 sm:px-6 lg:px-8';
const primaryCta =
  'inline-flex items-center justify-center rounded bg-amber-400 px-5 py-3 font-semibold text-charcoal-900 transition-colors hover:bg-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal-700';
const ghostCta =
  'inline-flex items-center justify-center rounded border border-white/25 px-5 py-3 font-semibold text-white transition-colors hover:border-white/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400';
---
<BaseLayout
  title="Shop All Rubber Flooring Products | Rukn Al Zain Dubai"
  description="Browse every Rukn Al Zain rubber flooring product in one place — acoustic underlays, gym tiles and rolls, and animal and agricultural mats and pavers, supplied across the UAE."
  canonical="/shop"
>
  <article>
    {/* Breadcrumb strip */}
    <div class="border-b border-industrial-300 bg-industrial-100">
      <div class={`${container} py-4`}>
        <Breadcrumbs trail={[{ name: 'Home', href: '/' }, { name: 'Shop' }]} />
      </div>
    </div>

    {/* Hero */}
    <header class="bg-charcoal-700 text-white">
      <div class={`${container} py-16`}>
        <h1 class="max-w-3xl text-4xl font-extrabold leading-tight text-white sm:text-[2.75rem]">
          Shop All Rubber Flooring Products
        </h1>

        {/* AEO direct-answer block */}
        <p class="mt-5 max-w-2xl border-l-[3px] border-amber-400 pl-4 text-lg text-industrial-100">
          Every Rukn Al Zain product in one place — {totalProducts} recycled-rubber flooring lines
          across acoustic underlay, gym and fitness flooring, and animal and agricultural matting.
          Filter by category below, then open any product for full technical specifications and to
          request a quote.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/contact" class={primaryCta}>Request a Quote</a>
          <a href="https://wa.me/971505698195" target="_blank" rel="noopener" class={ghostCta}>
            WhatsApp
          </a>
        </div>
      </div>
    </header>

    <div class={`${container} py-12`}>
      {/* Zero-JS category filter — radio inputs + sibling-combinator CSS. */}
      <div class="shop">
        {
          filters.map((f) => (
            <input
              type="radio"
              name="shop-filter"
              id={f.id}
              class="shop-filter-input sr-only"
              checked={f.key === 'all'}
            />
          ))
        }

        <div
          class="shop-filter flex flex-wrap gap-2"
          role="group"
          aria-label="Filter products by category"
        >
          {
            filters.map((f) => (
              <label
                for={f.id}
                data-chip={f.key}
                class="cursor-pointer select-none rounded border border-industrial-300 bg-white px-3.5 py-2 text-sm font-medium text-charcoal-600 transition-colors hover:border-amber-400"
              >
                {f.label}
                <span class="ml-1.5 tabular-nums text-charcoal-400">{f.count}</span>
              </label>
            ))
          }
        </div>

        <div class="shop-body">
          {
            groups.map((g) => (
              <section
                data-cat={g.hub.id}
                aria-labelledby={`cat-${g.hub.id}`}
                class="mt-14 scroll-mt-24"
              >
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <h2 id={`cat-${g.hub.id}`} class="text-2xl font-bold">
                    {g.hub.data.navLabel}
                    <span class="ml-2 text-base font-semibold text-charcoal-400">
                      {g.products.length}
                    </span>
                  </h2>
                  <a
                    href={g.hub.data.path}
                    class="rounded text-sm font-semibold text-amber-700 hover:text-amber-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
                  >
                    View category &rarr;
                  </a>
                </div>

                <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                  {g.products.map((c) => (
                    <li>
                      <a
                        href={c.data.path}
                        class="flex h-full flex-col overflow-hidden rounded border border-industrial-300 bg-white transition-colors hover:border-amber-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
                      >
                        {productImages[c.data.path] ? (
                          <img
                            src={productImages[c.data.path]}
                            alt={c.data.imageAlt}
                            width="1024"
                            height="1024"
                            loading="lazy"
                            decoding="async"
                            class="aspect-[4/3] w-full border-b border-industrial-300 bg-industrial-100 object-cover"
                          />
                        ) : (
                          <Image
                            src={images[c.data.image]}
                            alt={c.data.imageAlt}
                            widths={[300, 600]}
                            sizes="(min-width: 1024px) 20rem, (min-width: 640px) 45vw, 100vw"
                            class="aspect-[4/3] w-full border-b border-industrial-300 object-cover"
                            loading="lazy"
                          />
                        )}
                        <span class="flex flex-1 flex-col p-5">
                          <span class="font-heading text-lg font-semibold text-charcoal">
                            {productName(c.data.h1)}
                          </span>
                          {c.data.tagline && (
                            <span class="mt-1.5 flex-1 text-sm text-charcoal-500">
                              {c.data.tagline}
                            </span>
                          )}
                          <span class="mt-3 text-sm font-semibold text-amber-700">
                            View product &rarr;
                          </span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </div>
    </div>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)} />

    {/* CTA */}
    <section class="bg-charcoal-700 text-white">
      <div class={`${container} flex flex-col items-start gap-4 py-12 sm:flex-row sm:items-center sm:justify-between`}>
        <p class="max-w-xl text-lg">
          Request the technical specification sheet or a project quote for any product above.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/contact" class={primaryCta}>Request a Quote</a>
          <a href="https://wa.me/971505698195" target="_blank" rel="noopener" class={ghostCta}>
            WhatsApp
          </a>
        </div>
      </div>
    </section>
  </article>

  {/*
    Zero-JS filter behaviour. All `.shop-*` selectors are page-unique so this is
    safe as an is:global block (matches the pattern used on rubber-gym-tiles.astro).
    Without CSS support every section stays visible — the radios just fall back to
    an inert control group.
  */}
  <style is:global>
    /* Hide the category sections that don't match the active filter. */
    #shop-acoustic:checked ~ .shop-body > section:not([data-cat='acoustic']),
    #shop-gym:checked ~ .shop-body > section:not([data-cat='gym']),
    #shop-animal:checked ~ .shop-body > section:not([data-cat='animal']) {
      display: none;
    }

    /* No leading gap above whichever section shows first in each filter state. */
    #shop-all:checked ~ .shop-body > section[data-cat='acoustic'],
    #shop-acoustic:checked ~ .shop-body > section[data-cat='acoustic'],
    #shop-gym:checked ~ .shop-body > section[data-cat='gym'],
    #shop-animal:checked ~ .shop-body > section[data-cat='animal'] {
      margin-top: 0;
    }

    /* Active chip — amber fill with charcoal text (brand active state). */
    #shop-all:checked ~ .shop-filter label[data-chip='all'],
    #shop-acoustic:checked ~ .shop-filter label[data-chip='acoustic'],
    #shop-gym:checked ~ .shop-filter label[data-chip='gym'],
    #shop-animal:checked ~ .shop-filter label[data-chip='animal'] {
      background-color: #f8b03a;
      border-color: #f8b03a;
      color: #15171b;
    }
    #shop-all:checked ~ .shop-filter label[data-chip='all'] span,
    #shop-acoustic:checked ~ .shop-filter label[data-chip='acoustic'] span,
    #shop-gym:checked ~ .shop-filter label[data-chip='gym'] span,
    #shop-animal:checked ~ .shop-filter label[data-chip='animal'] span {
      color: inherit;
      opacity: 0.65;
    }

    /* Mirror the keyboard focus ring from the hidden radio onto its chip. */
    #shop-all:focus-visible ~ .shop-filter label[data-chip='all'],
    #shop-acoustic:focus-visible ~ .shop-filter label[data-chip='acoustic'],
    #shop-gym:focus-visible ~ .shop-filter label[data-chip='gym'],
    #shop-animal:focus-visible ~ .shop-filter label[data-chip='animal'] {
      outline: 2px solid #9b610b;
      outline-offset: 2px;
    }
  </style>
</BaseLayout>
