/* ─── Structured data — single combined @graph ───────────────────────────
   BreadcrumbList + Product (+ Offer) + FAQPage from the build request, with all
   URLs rebased onto the configured host. The visible breadcrumb trail is
   hand-rolled below (not the <Breadcrumbs /> component) so the BreadcrumbList is
   declared exactly once. Organization JSON-LD is emitted sitewide by
   BaseLayout. */
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Outdoor Pavers',
      item: `${SITE}/outdoor-pavers`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'ZainPavers Dog Bone',
      item: `${SITE}${PATH}`,
    },
  ],
};

const productSchema = {
  '@type': 'Product',
  name: 'ZainPavers Dog Bone',
  image: `${SITE}${OG_IMG}`,
  description:
    'Dense, heavy-duty interlocking dog bone rubber pavers designed for equestrian walkways, farm paddocks, and garden paths.',
  sku: 'RZ-PAVER-DB',
  category: 'Outdoor Rubber Pavers',
  brand: { '@type': 'Brand', name: 'Rukn Al Zain' },
  manufacturer: { '@type': 'Organization', name: 'Rukn Al Zain General Trading LLC' },
  material: 'Recycled SBR rubber granules bound with polyurethane binder',
  areaServed: 'United Arab Emirates',
  offers: {
    '@type': 'Offer',
    url: `${SITE}${PATH}`,
    priceCurrency: 'AED',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
};

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [breadcrumbSchema, productSchema, faqSchema],
};

/* Shared class helpers — mirrors src/pages/outdoor-pavers/hexagon.astro. */
const sectionShell = 'border-t border-industrial-300 py-14 sm:py-16';
const container = 'mx-auto max-w-content px-4 sm:px-6 lg:px-8';
const h2 = 'text-2xl font-bold text-charcoal';
const lede = 'mt-4 max-w-3xl text-charcoal-600';
const primaryCta =
  'inline-flex items-center justify-center rounded bg-amber-400 px-5 py-3 font-semibold text-charcoal-900 transition-colors hover:bg-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2';
const waCta =
