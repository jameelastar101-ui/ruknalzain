   Pavers) + a Product node per CLAUDE.md §5 + FAQPage reproduced 1:1 from the
   on-page FAQ. The visible breadcrumb trail is hand-rolled below (not the
   <Breadcrumbs /> component) so the BreadcrumbList is declared exactly once.
   Organization JSON-LD is emitted sitewide by BaseLayout. */
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Outdoor Pavers',
      item: `${SITE}/outdoor-pavers`,
    },
    { '@type': 'ListItem', position: 3, name: 'Zain Hexagon Pavers', item: `${SITE}${PATH}` },
  ],
};

const productSchema = {
  '@type': 'Product',
  name: 'Zain Hexagon Pavers',
  description:
    'Decorative six-sided interlocking rubber paver moulded from high-density recycled SBR granules and heat-stable polyurethane binder. Laid over compacted sand, aggregate or concrete to give villa gardens, equestrian paths, farm livestock walkways and outdoor play areas a non-slip, permeable, shock-absorbing surface that flexes with sandy sub-base movement without cracking and stays cooler than stone or concrete under Dubai heat. Available in 20, 25, 40 and 50 mm thicknesses.',
  image: `${SITE}${OG_IMG}`,
  sku: 'RZ-HEXAGON-PAVER',
  category: 'Outdoor Rubber Pavers',
  url: `${SITE}${PATH}`,
  brand: { '@type': 'Brand', name: 'Rukn Al Zain' },
  manufacturer: { '@type': 'Organization', name: 'Rukn Al Zain General Trading LLC' },
  material: 'Recycled SBR rubber granules bound with polyurethane binder',
  areaServed: 'United Arab Emirates',
};

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [breadcrumbSchema, productSchema, faqSchema],
};

/* Shared class helpers — mirrors src/pages/hammer-top.astro. */
const sectionShell = 'border-t border-industrial-300 py-14 sm:py-16';
const container = 'mx-auto max-w-content px-4 sm:px-6 lg:px-8';
const h2 = 'text-2xl font-bold text-charcoal';
const lede = 'mt-4 max-w-3xl text-charcoal-600';
const primaryCta =
  'inline-flex items-center justify-center rounded bg-amber-400 px-5 py-3 font-semibold text-charcoal-900 transition-colors hover:bg-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2';
const waCta =
  'inline-flex items-center justify-center gap-2 rounded bg-emerald-600 px-5 py-3 font-semibold text-white transition-colors hover:bg-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2';
const iconChip =
  'mb-3 grid h-11 w-11 place-items-center rounded bg-white text-amber-700 ring-1 ring-industrial-300';
const crumbLink =
  'rounded hover:text-amber-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700';
const fieldClass =
  'mt-1.5 block w-full rounded border border-charcoal-300 bg-white px-3 py-2.5 text-charcoal shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-700';
const labelClass = 'block text-sm font-medium text-charcoal';
const svgAttrs = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.75',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  class: 'h-6 w-6',
};
---

<BaseLayout
  title="Hexagon Rubber Pavers Dubai | Geometric Farm & Garden Pavers | Rukn Al Zain"
  description="Decorative geometric hexagon rubber pavers in Dubai. UV-resistant, non-slip paving solution for luxury farm walkways, gardens, and equestrian paths."
  canonical={PATH}
  ogImage={OG_IMG}
  ogImageAlt="Zain Hexagon geometric recycled-rubber pavers by Rukn Al Zain, Dubai UAE."
>
  <article class="hx-page">
    {/*
      Mark the document as JS-capable ASAP so scroll-reveal elements start hidden
      only when the animation engine is available. A failsafe timer guarantees
      content becomes visible even if the observer below never runs, and
      reduced-motion visitors skip the effect entirely.
    */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('hx-js');
        var sel = '.hx-page [data-reveal], .hx-page [data-reveal-group]';
        var showAll = function () {
          document.querySelectorAll(sel).forEach(function (el) {
            el.classList.add('in');
          });
        };
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', showAll);
          else showAll();
        } else {
          setTimeout(showAll, 1600);
        }
      })();
    </script>

    {/* Breadcrumb strip — Home > Outdoor Pavers > Zain Hexagon Pavers.
        Hand-rolled (not <Breadcrumbs />) so the BreadcrumbList JSON-LD is
        declared once, in the combined @graph at the foot of this file. */}
    <div class="border-b border-industrial-300 bg-industrial-100">
      <div class={`${container} py-4`}>
        <nav aria-label="Breadcrumb" class="text-sm">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-charcoal-500">
            <li class="flex items-center gap-x-2">
              <a href="/" class={crumbLink}>Home</a>
            </li>
            <li class="flex items-center gap-x-2">
              <span aria-hidden="true" class="text-charcoal-300">/</span>
              <a href="/outdoor-pavers" class={crumbLink}>Outdoor Pavers</a>
            </li>
            <li class="flex items-center gap-x-2">
              <span aria-hidden="true" class="text-charcoal-300">/</span>
              <span aria-current="page" class="font-medium text-charcoal">Zain Hexagon Pavers</span>
            </li>
          </ol>
        </nav>
      </div>
    </div>

    {/* ─── 1. HERO ─────────────────────────────────────────────────────────── */}
    <header class="bg-charcoal-700 text-white">
      <div class={`${container} py-14 sm:py-16`}>
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div data-hero>
            <p class="font-heading text-sm font-semibold uppercase tracking-wide text-amber-400">
              Geometric Outdoor Rubber Pavers
            </p>
            <h1 class="mt-3 text-4xl font-extrabold leading-tight text-white sm:text-5xl">
              Zain Hexagon &mdash; Geometric Outdoor Rubber Pavers Dubai
            </h1>

            {/* AEO direct-answer block — sits immediately under the H1 */}
            <p class="mt-5 max-w-xl border-l-[3px] border-amber-400 pl-4 text-lg text-industrial-100">
              Zain Hexagon pavers are six-sided recycled-rubber paving units that tile edge to edge
              into a continuous, non-slip, cushioned path. Rukn Al Zain General Trading LLC supplies
              them from central Dubai stock for high-end villa gardens, farm walkways and equestrian
              pathways across the UAE &mdash; a decorative surface that flexes with sandy ground
              instead of cracking like concrete.
            </p>

            <p class="mt-5 max-w-xl text-industrial-200">
              Decorative, non-slip geometric rubber paving engineered for high-end farm walkways,
              villa gardens, and equestrian pathways across Dubai and the UAE.
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#lead-capture" class={`${primaryCta} focus-visible:ring-offset-charcoal-700`}>
                Request Free Sample &amp; Quote
              </a>
              <a
                href={WHATSAPP_HERO}
                target="_blank"
                rel="noopener"
                class={`${waCta} focus-visible:ring-offset-charcoal-700`}
              >
                <svg {...svgAttrs} fill="currentColor" stroke="none" class="h-5 w-5" set:html={waGlyph} />
                WhatsApp Us
              </a>
            </div>
          </div>

          <figure class="m-0" data-hero>
            <img
              src={HERO_IMG}
              alt={HERO_ALT}
              title="Zain Hexagon geometric recycled rubber pavers — Rukn Al Zain, Dubai"
              width="1024"
              height="1024"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-auto w-full rounded border border-white/10"
            />
          </figure>
        </div>
      </div>
    </header>

    {/* ─── 2. TRUST BAR ───────────────────────────────────────────────────── */}
    <section aria-labelledby="trust-h" class={`${sectionShell} bg-white`}>
      <div class={container}>
        <h2 id="trust-h" class={h2} data-reveal>
          Geometric Rubber Pavers Stocked in Dubai
        </h2>
        <dl class="mt-8 grid gap-5 grid-cols-2 lg:grid-cols-4" data-reveal-group>
          {
            trustCards.map((it) => (
              <div class="card-lift rounded border border-industrial-300 border-l-[3px] border-l-amber-400 bg-industrial-100 p-5">
                <span class={iconChip} aria-hidden="true">
                  <svg {...svgAttrs} set:html={icon[it.icon]} />
                </span>
                <dt class="font-heading font-semibold text-charcoal">{it.term}</dt>
                <dd class="mt-1.5 text-sm text-charcoal-600">{it.desc}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {/* ─── 3. PROBLEM & SOLUTION ──────────────────────────────────────────── */}
    <section aria-labelledby="ps-h" class={`${sectionShell} bg-industrial-100`}>
      <div class={container}>
        <h2 id="ps-h" class={h2} data-reveal>
          From Cracked Concrete to Interlocking Hexagon Pavers
        </h2>

        <div class="mt-8 grid gap-6 lg:grid-cols-2" data-reveal-group>
          {/* The Problem */}
          <div class="rounded border border-industrial-300 border-l-[3px] border-l-danger bg-white p-6">
            <h3 class="font-heading text-lg font-bold text-charcoal">
              The Problem: Cracked, Slippery Concrete
            </h3>
            <p class="mt-3 text-sm text-charcoal-600">
              Traditional concrete and stone paving tiles absorb intense solar heat, crack under
              ground settlement in sandy soil, and create slick, dangerous surfaces when exposed to
              garden irrigation runoff or high humidity.
            </p>
            <dl class="mt-4 space-y-4">
              {
                problemPoints.map((p) => (
                  <div>
                    <dt class="flex gap-2 font-heading text-sm font-semibold text-charcoal">
                      <span class="mt-0.5 text-danger" aria-hidden="true">&#10007;</span>
                      <span>{p.term}</span>
                    </dt>
                    <dd class="mt-1 pl-6 text-sm text-charcoal-600">{p.desc}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          {/* The Solution */}
          <div class="rounded border border-industrial-300 border-l-[3px] border-l-success bg-white p-6">
            <h3 class="font-heading text-lg font-bold text-charcoal">
              The Solution: Interlocking Zain Hexagon Rubber Pavers
            </h3>
            <p class="mt-3 text-sm text-charcoal-600">
              Engineered from high-density SBR rubber bound with heat-stable polyurethane, Zain
              Hexagon pavers adjust slightly to sandy sub-base shifts without cracking, provide
              multi-directional traction, and act as a thermal barrier against direct ground heat.
            </p>
            <dl class="mt-4 space-y-4">
              {
                solutionPoints.map((s) => (
                  <div>
                    <dt class="flex gap-2 font-heading text-sm font-semibold text-charcoal">
                      <span class="mt-0.5 text-success" aria-hidden="true">&#10003;</span>
                      <span>{s.term}</span>
                    </dt>
                    <dd class="mt-1 pl-6 text-sm text-charcoal-600">{s.desc}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        <figure class="m-0 mt-10" data-reveal>
          <img
            src={PS_IMG}
            alt={PS_ALT}
            title="Cracked concrete versus interlocking Zain Hexagon rubber pavers on a Dubai walkway"
            width="1376"
            height="768"
            loading="lazy"
            decoding="async"
            class="h-auto w-full rounded border border-industrial-300"
          />
        </figure>
      </div>
    </section>

    {/* ─── 4. KEY PRODUCT BENEFITS ────────────────────────────────────────── */}
    <section aria-labelledby="benefits-h" class={`${sectionShell} bg-white`}>
      <div class={container}>
        <h2 id="benefits-h" class={h2} data-reveal>Key Product Benefits</h2>
        <dl class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
          {
            benefits.map((it) => (
              <div class="card-lift rounded border border-industrial-300 bg-industrial-100 p-5">
                <span class={iconChip} aria-hidden="true">
                  <svg {...svgAttrs} set:html={icon[it.icon]} />
                </span>
                <dt class="font-heading font-semibold text-charcoal">{it.term}</dt>
                <dd class="mt-1.5 text-sm text-charcoal-600">{it.desc}</dd>
              </div>
            ))
          }
        </dl>

        <figure class="m-0 mt-10" data-reveal>
          <img
            src={BENEFITS_IMG}
            alt={BENEFITS_ALT}
            title="Six-sided interlocking edges and textured non-slip face of Zain Hexagon pavers"
            width="1024"
            height="1024"
            loading="lazy"
            decoding="async"
            class="mx-auto h-auto w-full max-w-3xl rounded border border-industrial-300"
          />
        </figure>
      </div>
    </section>

    {/* ─── 5. TECHNICAL SPECIFICATIONS ────────────────────────────────────── */}
    <section aria-labelledby="specs-h" class={`${sectionShell} bg-industrial-100`}>
      <div class={container}>
        <h2 id="specs-h" class={h2} data-reveal>Technical Specifications</h2>
        <p class={lede} data-reveal>
          Material base, tile pattern, thickness range, density, temperature resistance and drainage
          for the Zain Hexagon paver. Figures are
          <span class="font-semibold text-amber-700"> provisional</span> pending confirmation against
          manufacturer product data and test certificates.
        </p>

        <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:items-start" data-reveal-group>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm tabular-nums">
              <caption class="sr-only">
                Zain Hexagon paver technical specifications and material profile
              </caption>
              <thead>
                <tr class="border-b-2 border-charcoal-300">
                  {
                    specHead.map((th) => (
                      <th scope="col" class="px-4 py-3 font-heading font-bold text-charcoal">
                        {th}
                      </th>
                    ))
                  }
                </tr>
              </thead>
              <tbody>
                {
                  specRows.map(([label, value], i) => (
                    <tr class:list={['border-b border-industrial-300', i % 2 === 1 && 'bg-white']}>
                      <th scope="row" class="w-2/5 px-4 py-3 align-top font-semibold text-charcoal">
                        {label}
                      </th>
                      <td class="px-4 py-3 align-top text-charcoal-600">{value}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <figure class="m-0">
            <img
              src={SPEC_IMG}
              alt={SPEC_ALT}
              title="Rubber paver thickness options, recycled SBR body and underside drainage channels"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
              class="h-auto w-full rounded border border-industrial-300"
            />
          </figure>
        </div>

        {/* TODO: Missing spec from brief — hexagon-pavers.yaml lists "Paver size
            (across flats)" (mm), "Thickness" (mm) and "Colour options" as null
            "to collect". The thickness set (20/25/40/50 mm), density band
            (900–1050 kg/m³) and −20/+80 °C range above are descriptive copy from
            the page-build request, not manufacturer-certified data (the same
            figures are flagged provisional on outdoor-pavers.astro). Confirm the
            recycled-rubber composition, paver dimensions, thickness options,
            colour range, density and any tested slip-resistance figures against
            real product data / manufacturer certificates before go-live. */}
        <p class="mt-3 text-xs text-charcoal-500" data-reveal>
          Specifications are provisional pending final manufacturer product data and test
          certificates. Request the current Zain Hexagon paver technical datasheet for confirmed
          paver size, thickness, colour and density figures.
        </p>
      </div>
    </section>

    {/* ─── 6. BEST FOR / IDEAL APPLICATIONS ───────────────────────────────── */}
    <section aria-labelledby="apps-h" class={`${sectionShell} bg-white`}>
      <div class={container}>
        <h2 id="apps-h" class={h2} data-reveal>Best For / Ideal Applications</h2>
        <dl class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
          {
            applications.map((it) => (
              <div class="card-lift rounded border border-industrial-300 border-l-[3px] border-l-amber-400 bg-industrial-100 p-5">
                <span class={iconChip} aria-hidden="true">
                  <svg {...svgAttrs} set:html={icon[it.icon]} />
                </span>
                <dt class="font-heading font-semibold text-charcoal">{it.term}</dt>
                <dd class="mt-1.5 text-sm text-charcoal-600">{it.desc}</dd>
              </div>
            ))
          }
        </dl>

        <figure class="m-0 mt-10" data-reveal>
          {/* TODO: Missing assets from brief — per-card application photos; using
              the shared outdoor-pavers applications-grid render for the row. */}
          <img
            src={APPS_IMG}
            alt={APPS_ALT}
            title="Hexagon rubber paver applications across the UAE — Rukn Al Zain"
            width="1376"
            height="768"
            loading="lazy"
            decoding="async"
            class="h-auto w-full rounded border border-industrial-300"
          />
        </figure>
      </div>
    </section>

    {/* ─── 7. GEOGRAPHIC SIGNALS ──────────────────────────────────────────── */}
    <section aria-labelledby="geo-h" class={`${sectionShell} bg-industrial-100`}>
      <div class={container}>
        <h2 id="geo-h" class={h2} data-reveal>Built for Dubai&rsquo;s Harsh Microclimates</h2>

        <div class="mt-8 grid items-start gap-10 lg:grid-cols-2">
          <figure class="m-0" data-reveal>
            <img
              src={GEO_IMG}
              alt={GEO_ALT}
              title="Zain Hexagon rubber pavers along a luxury villa pathway in Dubai"
              width="1376"
              height="768"
              loading="lazy"
              decoding="async"
              class="h-auto w-full rounded border border-industrial-300"
            />
          </figure>

          <div data-reveal-group>
            <dl class="space-y-4">
              {
                geoSignals.map((it) => (
                  <div class="rounded border border-industrial-300 border-l-[3px] border-l-amber-400 bg-white p-4">
                    <dt class="flex items-center gap-2 font-heading font-semibold text-charcoal">
                      <span class="text-amber-700" aria-hidden="true">
                        <svg {...svgAttrs} class="h-5 w-5" set:html={icon[it.icon]} />
                      </span>
                      {it.term}
                    </dt>
                    <dd class="mt-1.5 text-sm text-charcoal-600">{it.desc}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

    {/* ─── 8. ABOUT RUKN AL ZAIN & DELIVERY ───────────────────────────────── */}
    <section aria-labelledby="rzn-h" class={`${sectionShell} bg-white`}>
      <div class={container}>
        <h2 id="rzn-h" class={h2} data-reveal>About Rukn Al Zain &amp; Delivery</h2>
        <p class={lede} data-reveal>
          Rukn Al Zain General Trading LLC is a premier Dubai-based distributor supplying specialised
          rubber flooring solutions directly to residential, commercial and agricultural projects
          across the UAE.
        </p>

        <h3 class="mt-10 font-heading text-lg font-bold text-charcoal" data-reveal>
          How Ordering Works
        </h3>
        <ol class="mt-6 grid gap-5 sm:grid-cols-3" data-reveal-group>
          {
            processSteps.map((s) => (
              <li class="card-lift flex h-full flex-col rounded border border-industrial-300 bg-industrial-100 p-5">
                <div class="flex items-center justify-between">
                  <span class="grid h-11 w-11 place-items-center rounded bg-white text-amber-700 ring-1 ring-industrial-300" aria-hidden="true">
                    <svg {...svgAttrs} set:html={icon[s.icon]} />
                  </span>
                  <span class="font-heading text-2xl font-extrabold text-industrial-400" aria-hidden="true">
                    {s.n}
                  </span>
                </div>
                <h4 class="mt-3 font-heading text-base font-bold text-charcoal">{s.term}</h4>
                <p class="mt-1.5 text-sm text-charcoal-600">{s.desc}</p>
              </li>
            ))
          }
        </ol>

        <h3 class="mt-12 font-heading text-lg font-bold text-charcoal" data-reveal>
          Delivery Coverage Across the UAE
        </h3>
        <p class="mt-4 max-w-3xl text-charcoal-600" data-reveal>
          Direct dispatch to <span class="font-semibold text-charcoal">Dubai (24-hour express)</span>,
          {' '}Abu Dhabi, Sharjah, Ajman, Ras Al Khaimah, Umm Al Quwain and Fujairah &mdash; typically
          within 24 to 48 hours of order confirmation.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2.5" data-reveal-group>
          {
            coverageAreas.map((area) => (
              <li class="inline-flex items-center gap-1.5 rounded border border-industrial-300 bg-industrial-100 px-3 py-1.5 text-sm font-medium text-charcoal">
                <svg {...svgAttrs} class="h-4 w-4 text-amber-700" set:html={icon['map-pin']} aria-hidden="true" />
                {area}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ─── 9. FAQ — accordion (native <details>, zero-JS) ─────────────────── */}
    <section aria-labelledby="faq-h" class={`${sectionShell} bg-industrial-100`}>
      <div class={container}>
        <h2 id="faq-h" class={h2} data-reveal>Frequently Asked Questions</h2>
        <div
          class="mt-6 max-w-3xl divide-y divide-industrial-300 border-y border-industrial-300"
          data-reveal-group
        >
          {
            faqs.map((f, i) => (
              <details class="group" open={i === 0}>
                <summary class="flex cursor-pointer items-center justify-between gap-4 py-4 font-heading text-base font-semibold text-charcoal marker:content-none [&::-webkit-details-marker]:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700">
                  <span>{f.question}</span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-5 w-5 shrink-0 text-amber-700 transition-transform duration-200 group-open:-rotate-180"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="pb-4 text-charcoal-600">{f.answer}</p>
              </details>
            ))
          }
        </div>

        {/* Internal link: spoke → hub + paver sibling, keyword anchor text */}
        <p class="mt-8 max-w-3xl text-sm text-charcoal-600" data-reveal>
          Zain Hexagon pavers are part of Rukn Al Zain&rsquo;s{' '}
          <a
            href="/outdoor-pavers"
            class="rounded font-semibold text-amber-700 hover:text-amber-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
          >
            outdoor rubber paver range
          </a>. For high animal-impact walkways and paddock routes, see the interlocking{' '}
          <a
            href="/outdoor-pavers/dogbone"
            class="rounded font-semibold text-amber-700 hover:text-amber-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
          >
            Zain Pavers Dog Bone
          </a>.
        </p>
      </div>
    </section>

    {/* Combined BreadcrumbList + Product + FAQPage structured data (@graph).
        Kept in-body to match the sibling spoke pages (BaseLayout exposes no
        <head> slot); crawlers parse it identically. Organization JSON-LD is
        emitted sitewide by BaseLayout. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(graphSchema)} />

