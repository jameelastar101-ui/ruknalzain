<BaseLayout
  title="Sports Track Underlay Dubai | Zain Prime Shock Absorption | Rukn Al Zain"
  description="Zain Prime cushions sports tracks and courts, absorbing impact and reducing noise while improving playing surface stability across wood, vinyl, and synthetic surfaces in Dubai."
  canonical={PATH}
  ogImage={OG_IMG}
  ogImageAlt="Zain Prime recycled SBR rubber sports track and court underlay by Rukn Al Zain, Dubai UAE."
>
  <article class="st-page">
    {/*
      Mark the document as JS-capable ASAP so scroll-reveal elements start hidden
      only when the animation engine is available. A failsafe timer guarantees
      content becomes visible even if the observer below never runs, and
      reduced-motion visitors skip the effect entirely.
    */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('st-js');
        var sel = '.st-page [data-reveal], .st-page [data-reveal-group]';
        var showAll = function () {
          document.querySelectorAll(sel).forEach(function (el) {
            el.classList.add('in');
          });
        };
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', showAll);
          else showAll();
        } else {
          setTimeout(showAll, 1600);
        }
      })();
    </script>

    {/* Breadcrumb strip — Home > Acoustic & Soundproofing Flooring > Zain Prime.
        Hand-rolled (not <Breadcrumbs />) so the BreadcrumbList JSON-LD is
        declared once, in the combined @graph at the foot of this file. */}
    <div class="border-b border-industrial-300 bg-industrial-100">
      <div class={`${container} py-4`}>
        <nav aria-label="Breadcrumb" class="text-sm">
