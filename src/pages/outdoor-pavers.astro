            <img
              src={HERO_IMG}
              alt={HERO_ALT}
              title="Outdoor rubber pavers installed along a sunlit Dubai walkway"
              width="1408"
              height="768"
              loading="eager"
              fetchpriority="high"
              decoding="async"
