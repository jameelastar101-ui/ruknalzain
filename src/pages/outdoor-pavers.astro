<BaseLayout
  title="Outdoor Rubber Pavers Dubai | Dog Bone & Hexagon Pavers | Rukn Al Zain"
  description="Interlocking outdoor rubber pavers for equestrian walkways, garden paths, and farm paddocks in Dubai."
  canonical="/outdoor-pavers"
  ogImage={HERO_IMG}
  ogImageAlt={HERO_ALT}
>
  <article>
    {/* Breadcrumb strip — emits BreadcrumbList JSON-LD via the shared component */}
    <div class="border-b border-industrial-300 bg-industrial-100">
      <div class={`${container} py-4`}>
