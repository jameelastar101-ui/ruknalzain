    {/* ─── SUBTLE MOTION ──────────────────────────────────────────────────────
        A one-shot load-in for the hero (pure CSS, cannot get stuck hidden) and a
        staggered scroll-reveal (fade + short rise) for headings, card groups,
        figures, the spec table, the FAQ and the lead form. Plus a small hover
        lift on cards. Progressive enhancement only — content is fully visible
        without JS, and every effect is disabled under prefers-reduced-motion. */}
    <style is:global>
      /* Hero: animate in on load. No fill-mode / delay, so if the animation
         engine never runs the element simply rests in its visible state. */
      .rgt-js .rgt-page [data-hero] {
        animation: rgt-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes rgt-rise {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
      }

      /* Scroll-reveal: hidden until .in is added (by the observer, or the
         inline failsafe timer). */
      .rgt-js .rgt-page [data-reveal],
      .rgt-js .rgt-page [data-reveal-group] > * {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .rgt-js .rgt-page [data-reveal].in,
      .rgt-js .rgt-page [data-reveal-group].in > * {
        opacity: 1;
        transform: none;
      }
      /* Stagger the children of a revealed group. */
      .rgt-js .rgt-page [data-reveal-group].in > *:nth-child(2) { transition-delay: 0.06s; }
      .rgt-js .rgt-page [data-reveal-group].in > *:nth-child(3) { transition-delay: 0.12s; }
      .rgt-js .rgt-page [data-reveal-group].in > *:nth-child(4) { transition-delay: 0.18s; }
      .rgt-js .rgt-page [data-reveal-group].in > *:nth-child(5) { transition-delay: 0.24s; }
      .rgt-js .rgt-page [data-reveal-group].in > *:nth-child(6) { transition-delay: 0.30s; }
      .rgt-js .rgt-page [data-reveal-group].in > *:nth-child(n + 7) { transition-delay: 0.36s; }

      /* Small hover lift on cards. */
      .rgt-page .card-lift {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      .rgt-page .card-lift:hover {
        transform: translateY(-3px);
      }

      @media (prefers-reduced-motion: reduce) {
        .rgt-js .rgt-page [data-hero] {
          animation: none;
        }
        .rgt-js .rgt-page [data-reveal],
        .rgt-js .rgt-page [data-reveal-group] > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .rgt-page .card-lift,
        .rgt-page .card-lift:hover {
          transition: none;
          transform: none;
        }
      }
    </style>

    <script>
      const targets = document.querySelectorAll(
        '.rgt-page [data-reveal], .rgt-page [data-reveal-group]',
      );
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealAll = () => targets.forEach((el) => el.classList.add('in'));

      if (reduce || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
        // Redundant safety net alongside the inline timer.
        window.addEventListener('load', () => setTimeout(revealAll, 1200));
      }
    </script>
  </article>
</BaseLayout>
