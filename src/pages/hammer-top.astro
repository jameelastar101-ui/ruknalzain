                  href={WHATSAPP_PLAIN}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center justify-center rounded border border-charcoal-300 px-5 py-3 font-semibold text-charcoal transition-colors hover:border-charcoal-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
                >
                  Order Free Sample on WhatsApp
                </a>
              </div>
              <p class="text-xs text-charcoal-400">
                Submissions are handled by Netlify Forms on the live site.
              </p>
            </form>
          </div>
          </div>
        </div>
      </div>
    </section>

    <script is:inline>
      // Progressive enhancement only: reveals the success banner in place of
      // the quote form when the Netlify form redirect lands back here with
      // ?submitted (static output has no server adapter, so this can't be a
      // build/render-time check — see src/pages/contact.astro for the same
      // pattern and the fuller explanation).
      if (new URLSearchParams(window.location.search).has('submitted')) {
        document.getElementById('quote-success')?.classList.remove('hidden');
        document.getElementById('quote-form-panel')?.classList.add('hidden');
      }
    </script>

    {/* ─── SUBTLE MOTION ──────────────────────────────────────────────────────
        One-shot CSS load-in for the hero and a staggered scroll-reveal for
        headings, card groups, figures and the spec table. Progressive
        enhancement only — content is fully visible without JS, and every effect
        is disabled under prefers-reduced-motion. Mirrors acoustic-strips.astro. */}
    <style is:global>
      .ht-js .ht-page [data-hero] {
        animation: ht-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes ht-rise {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
      }

      .ht-js .ht-page [data-reveal],
      .ht-js .ht-page [data-reveal-group] > * {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .ht-js .ht-page [data-reveal].in,
      .ht-js .ht-page [data-reveal-group].in > * {
        opacity: 1;
        transform: none;
      }
      .ht-js .ht-page [data-reveal-group].in > *:nth-child(2) { transition-delay: 0.06s; }
      .ht-js .ht-page [data-reveal-group].in > *:nth-child(3) { transition-delay: 0.12s; }
      .ht-js .ht-page [data-reveal-group].in > *:nth-child(4) { transition-delay: 0.18s; }
      .ht-js .ht-page [data-reveal-group].in > *:nth-child(5) { transition-delay: 0.24s; }
      .ht-js .ht-page [data-reveal-group].in > *:nth-child(n + 6) { transition-delay: 0.3s; }

      .ht-page .card-lift {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      .ht-page .card-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px -6px rgb(42 45 52 / 0.18);
      }

      @media (prefers-reduced-motion: reduce) {
        .ht-js .ht-page [data-hero] {
          animation: none;
        }
        .ht-js .ht-page [data-reveal],
        .ht-js .ht-page [data-reveal-group] > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .ht-page .card-lift,
        .ht-page .card-lift:hover {
          transition: none;
          transform: none;
        }
      }
    </style>

    <script>
      const targets = document.querySelectorAll(
        '.ht-page [data-reveal], .ht-page [data-reveal-group]',
      );
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealAll = () => targets.forEach((el) => el.classList.add('in'));

      if (reduce || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
        window.addEventListener('load', () => setTimeout(revealAll, 1200));
      }
    </script>
  </article>
</BaseLayout>
