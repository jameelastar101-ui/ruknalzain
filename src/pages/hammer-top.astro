<BaseLayout
  title="Dairy Farm Rubber Mats Dubai | Zain Hammer Top | Rukn Al Zain"
  description="Durable, anti-slip hammer top rubber mats designed for dairy farms, livestock facilities, and washdown areas across Dubai. Ensures grip, easy cleaning, and animal comfort."
  canonical={PATH}
  ogImage={OG_IMG}
  ogImageAlt="Zain Hammer Top textured heavy-duty recycled rubber livestock mat by Rukn Al Zain, Dubai UAE."
>
  <article class="ht-page">
    {/*
      Mark the document as JS-capable ASAP so scroll-reveal elements start hidden
      only when the animation engine is available. A failsafe timer guarantees
      content becomes visible even if the observer below never runs, and
      reduced-motion visitors skip the effect entirely.
    */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('ht-js');
        var sel = '.ht-page [data-reveal], .ht-page [data-reveal-group]';
        var showAll = function () {
          document.querySelectorAll(sel).forEach(function (el) {
            el.classList.add('in');
          });
        };
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', showAll);
          else showAll();
        } else {
          setTimeout(showAll, 1600);
        }
      })();
    </script>

    {/* Breadcrumb strip — Home > Animal & Agricultural Flooring > Zain Hammer Top.
        Hand-rolled (not <Breadcrumbs />) so the BreadcrumbList JSON-LD is
        declared once, in the combined @graph at the foot of this file. The
