---
/**
 * Homepage.
 *
 * Rewritten to the client-supplied "Rukn Al Zain — Homepage Content" copy
 * (2026-09-22 update), formatted for AEO/GEO scannability. Section numbers in
 * comments below match that brief 1:1.
 *
 * Notes:
 *  - Brand-name capitalisation (Zain Acoustic Underlay, ZainSilence, ZainFit,
 *    ZainSquare, ZainActive, Zain Horse Mat, Zain Hammer Top, ZainPavers Dog
 *    Bone) follows each product's own canonical <h1>, not the brief's ad hoc
 *    "ZainAcoustic Underlay" spelling, to keep terminology consistent
 *    sitewide (CLAUDE.md §3 GEO).
 *  - WhatsApp CTAs use Tailwind's default emerald-600/700 (green) per the
 *    brief's "Button 2 (Emerald)" spec, matching the same deviation already
 *    used on /outdoor-pavers.
 *  - No new photography was supplied for the homepage in this update, so no
 *    <img> assets were added; existing bespoke pages already establish a
 *    photo-optional pattern for icon/text sections.
 *  - Technical spec figures (density, thickness, hardness, acoustic rating)
 *    are the brief's own "Universal Material Performance Standards" and are
 *    consistent with (a superset of) the per-product figures already
 *    published on /gym-flooring-rolls/zainactive-rolls and /gym-flooring-rolls.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Faq from '@components/Faq.astro';

const container = 'mx-auto max-w-content px-4 sm:px-6 lg:px-8';
const sectionShell = 'border-t border-industrial-300 py-14 sm:py-16';
const h2 = 'text-2xl font-bold text-charcoal';
const lede = 'mt-4 max-w-3xl text-charcoal-600';
const primaryCta =
  'inline-flex items-center justify-center rounded bg-amber-400 px-5 py-3 font-semibold text-charcoal-900 transition-colors hover:bg-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2';
const whatsappCta =
  'inline-flex items-center justify-center gap-2 rounded bg-emerald-600 px-5 py-3 font-semibold text-white transition-colors hover:bg-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2';

/* Section 2: Trust Bar — icon paths reused from the acoustic hub page's
   established icon set for visual and semantic consistency. */
const trustBar = [
  {
    icon: 'warehouse',
    term: 'Direct Dubai Inventory',
    desc: 'Large local reserves maintained in our Dubai hub ensure immediate loading and fast order fulfillment.',
  },
  {
    icon: 'shield',
    term: 'GCC Climate Engineering',
    desc: 'Formulated with premium MDI polyurethane binders to resist extreme heat, humidity, and thermal shifts.',
  },
  {
    icon: 'recycle',
    term: '100% Eco-Sustainable',
    desc: 'Made from high-density recycled SBR and EPDM rubber to support eco-friendly building standards.',
  },
  {
    icon: 'truck',
    term: 'Express UAE Delivery',
    desc: 'Dedicated site delivery network operating across all seven Emirates.',
  },
];

/* Section 3: Product Hub Overview */
const productHubs = [
  {
    title: 'Acoustic & Construction Soundproofing',
    body: 'Stop impact noise, footfall sound, and structural vibration in multi-story buildings. Our specialized underlays sit cleanly under tile, screed, marble, and engineered wood.',
    products: ['Zain Acoustic Underlay', 'ZainSilence Screed Isolation', 'Wall & Ceiling Strips'],
    href: '/acoustic-soundproofing-flooring',
    anchor: 'Explore Acoustic Solutions',
  },
  {
    title: 'Gym & Commercial Fitness Flooring',
    body: 'Protect subfloors, absorb heavy barbell drops, and dampen noise in fitness spaces. Designed for heavy traffic in commercial gyms, CrossFit boxes, and home studios.',
    products: ['ZainFit Interlocking Tiles', 'ZainSquare Heavy-Duty Tiles', 'ZainActive Continuous Rolls'],
    href: '/gym-fitness-flooring',
    anchor: 'Explore Fitness Flooring',
  },
  {
    title: 'Agricultural, Equine & Outdoor Pavers',
    body: 'Heavy-duty, non-slip rubber surfaces designed for animal safety, comfort, and outdoor durability. Ideal for horse stables, wash bays, dairy stalls, and garden walkways.',
    products: ['Zain Horse Mat', 'Zain Hammer Top', 'ZainPavers Dog Bone'],
    href: '/animal-agricultural-flooring',
    anchor: 'Explore Agricultural Solutions',
  },
];

/* Section 4: Problem & Solution */
const challenges = [
  {
    challenge: 'Extreme Solar Heat & Humidity Shifts',
    challengeDesc:
      'Standard flooring materials warp, curl along edges, or emit chemical odors under intense Middle Eastern thermal shifts.',
    solutionDesc:
      'Our rubber formulations use specialized, non-gassing MDI polyurethane binders that stay flat and flexible in high heat.',
  },
  {
    challenge: 'Noise & Impact Transfer in High-Rises',
    challengeDesc:
      'Footsteps, equipment movement, and gym weight drops create structural noise complaints across multi-story towers.',
    solutionDesc:
      'High-density SBR acoustic underlays dampen impact sound at the source, reducing noise transmission by up to 22 dB.',
  },
  {
    challenge: 'Project Delays From Overseas Shipping',
    challengeDesc:
      'Contractors frequently face project downtime waiting for international material shipments.',
    solutionDesc:
      'We store deep inventory directly in Dubai, providing same-day dispatch and 24-to-48-hour site delivery.',
  },
];

/* Section 5: Key Product Benefits */
const benefits = [
  {
    term: 'Impact Absorption',
    desc: 'Prevents concrete subfloor damage from heavy equipment, free weights, or animal hooves.',
  },
  {
    term: 'Acoustic Isolation',
    desc: 'Traps airborne noise and dampens low-frequency impact vibration between floors.',
  },
  {
    term: 'Non-Slip Traction',
    desc: 'Delivers high grip in wet or dry conditions, protecting athletes and livestock from slips.',
  },
  {
    term: 'Hygienic & Low Maintenance',
    desc: 'Non-porous surface finishes prevent sweat and moisture absorption for easy cleaning.',
  },
];

/* Section 6: Technical Specifications — "Universal Material Performance
   Standards", aggregated across the full product catalog. */
const specRows = [
  ['Material Base', 'Recycled SBR granules with optional EPDM color speckles'],
  ['Binder Type', 'High-grade MDI polyurethane elastomer'],
  ['Density Range', '950 kg/m³ to 1050 kg/m³'],
  ['Thickness Options', '6 mm to 40 mm'],
  ['Hardness Rating', '60° to 65° Shore A'],
  ['Acoustic Rating', 'Impact sound reduction from 18 dB to 22 dB'],
  ['Weathering', 'UV-resistant and thermally stable for GCC outdoors'],
];

/* Section 7: Ideal Applications Across the UAE */
const applications = [
  {
    term: 'Fitness Facilities',
    desc: 'Free-weight zones, functional fitness areas, cardio tracks, and home gyms.',
  },
  {
    term: 'Commercial Fit-Outs',
    desc: 'Acoustic underlays for residential high-rises, hotels, and multi-story offices.',
  },
  {
    term: 'Equine & Farms',
    desc: 'Horse stalls, livestock pens, animal wash bays, and transit corridors.',
  },
  {
    term: 'Outdoor Spaces',
    desc: 'Landscaped pathways, pool decks, play areas, and garden borders.',
  },
];

/* Section 8: About Rukn Al Zain */
const brandValues = [
  {
    term: 'Local Stocking Advantage',
    desc: 'Deep local inventory in Dubai means zero waiting time for overseas shipments.',
  },
  {
    term: 'Climate-Tested Durability',
    desc: 'Formulated with weather-resistant polyurethane binders to prevent cracking or warping.',
  },
  {
    term: 'Eco-Friendly Solutions',
    desc: 'Sustainable materials derived from recycled tires, helping projects meet green building standards.',
  },
];

const process = [
  [
    'Consultation & Quote',
    'Send us your project dimensions and requirements for a rapid recommendation and quote.',
  ],
  [
    'Free Material Sample',
    'We deliver physical samples directly to your office or job site to inspect quality.',
  ],
  [
    'Warehouse Dispatch',
    'Orders are picked directly from our Dubai warehouse and loaded for express delivery.',
  ],
  [
    'Technical Guidance',
    'Our specialists provide full advice on layout planning, subfloor prep, and adhesives.',
  ],
];

const deliveryAreas = [
  {
    term: 'Dubai (Primary Hub)',
    desc: 'Fast 24-hour dispatch to Downtown Dubai, Business Bay, Meydan, Al Khawaneej, Al Barsha, Palm Jumeirah, Dubai Hills Estate, and Arabian Ranches.',
  },
  {
    term: 'Other Emirates',
    desc: 'Direct site logistics servicing Abu Dhabi, Sharjah, Ajman, Ras Al Khaimah, Fujairah, and Umm Al Quwain.',
  },
];

/* Section 9: FAQ — feeds the visible Q&A block and FAQPage JSON-LD together. */
const faqs = [
  {
    question: 'Is Rukn Al Zain a local UAE company?',
    answer:
      'Yes. Rukn Al Zain General Trading LLC is based in Dubai, UAE. We store all products locally in our central warehouse to ensure direct, fast site delivery across all seven Emirates.',
  },
  {
    question: 'Can I get physical samples before ordering?',
    answer:
      'Yes. We deliver free sample kits of our gym tiles, acoustic underlays, and rubber pavers directly to your office or job site in the UAE.',
  },
  {
    question: 'Why use recycled SBR rubber flooring in Dubai?',
    answer:
      'High-density SBR rubber offers outstanding impact absorption, sound dampening, and slip resistance. It resists heavy wear and remains stable under GCC heat and humidity.',
  },
  {
    question: 'How thick should gym flooring tiles be?',
    answer:
      'Use 15 mm to 20 mm tiles for general cardio and machine areas. For free weights and heavy barbell drops, select 30 mm to 40 mm tiles to protect the subfloor.',
  },
  {
    question: 'How do acoustic underlays block impact noise?',
    answer:
      'Acoustic underlays isolate kinetic energy at the surface before it can travel into the concrete slab as sound vibration, reducing noise between floors by up to 22 dB.',
  },
  {
    question: 'Do your outdoor rubber pavers withstand UAE sun and heat?',
    answer:
      'Yes. Our pavers and stable mats use UV-stabilized MDI binders engineered not to harden, crack, or curl under extreme ambient heat.',
  },
  {
    question: 'How are rubber tiles installed?',
    answer:
      'Interlocking tiles can be loose-laid using connector pins for easy setup. For permanent high-traffic areas, tiles or rolls are glued directly to the subfloor using polyurethane adhesive.',
  },
  {
    question: 'What is the best way to clean rubber flooring?',
    answer:
      'Sweep or vacuum loose dirt daily. Clean periodically using a mop damp with water and a pH-neutral detergent. Avoid harsh chemical solvents or bleach.',
  },
];

/* Section 10: Lead Capture & Project Quote Form */
const emirates = [
  'Dubai',
  'Abu Dhabi',
  'Sharjah',
  'Ajman',
  'Ras Al Khaimah',
  'Umm Al Quwain',
  'Fujairah',
];
---

<BaseLayout
  title="Premium Sustainable Rubber Flooring & Acoustic Solutions | Rukn Al Zain Dubai"
  description="Rukn Al Zain General Trading LLC is Dubai's premier supplier of sustainable recycled rubber flooring, acoustic underlay, gym tiles, and agricultural mats across the UAE."
  canonical="/"
  businessSchema
>
  {/* Section 1: Hero */}
  <header class="bg-charcoal-700 text-white">
    <div class={`${container} py-16 sm:py-20`}>
      <h1 class="max-w-3xl text-4xl font-extrabold leading-tight text-white sm:text-5xl">
        Sustainable Rubber Flooring &amp; Acoustic Isolation Solutions in Dubai &amp; the UAE
      </h1>

      <p class="mt-5 max-w-2xl border-l-[3px] border-amber-400 pl-4 text-lg text-industrial-100">
        <strong class="font-semibold text-white">Rukn Al Zain General Trading LLC</strong> is a
        leading Dubai-based distributor of high-performance SBR and EPDM recycled rubber flooring
        systems. Specifically engineered to withstand severe GCC climatic conditions, our durable
        materials serve high-impact commercial gyms, soundproof residential developments,
        agricultural facilities, and outdoor walkways across all seven Emirates.
      </p>

      <ul class="mt-6 max-w-2xl space-y-2 text-industrial-200">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400"></span>
          <span><strong class="font-semibold text-white">Direct Warehouse Stock:</strong> Fast 24–48 hour site dispatch directly from our central Dubai hub.</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400"></span>
          <span><strong class="font-semibold text-white">Eco-Friendly &amp; High Density:</strong> Sustainable recycled rubber engineered for maximum impact absorption and longevity.</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400"></span>
          <span><strong class="font-semibold text-white">Full UAE Reach:</strong> Complete logistics coverage across Dubai, Abu Dhabi, Sharjah, Ajman, RAK, UAQ, and Fujairah.</span>
        </li>
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#request-quote" class={`${primaryCta} focus-visible:ring-offset-charcoal-700`}>
          Request Free Sample &amp; Quote
        </a>
        <a
          href="https://wa.me/971505698195?text=Hello%20Rukn%20Al%20Zain%2C%20I%20have%20an%20inquiry%20regarding%20your%20rubber%20flooring%20products."
          target="_blank"
          rel="noopener"
          class={whatsappCta}
        >
          WhatsApp Now (+971 50 569 8195)
        </a>
      </div>
    </div>
  </header>

  {/* Section 2: Trust Bar */}
  <section aria-labelledby="trust-bar-h" class={`${sectionShell} bg-white`}>
    <div class={container}>
      <h2 id="trust-bar-h" class={h2}>Trusted Local Rubber Supply Across the UAE</h2>
      <dl class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          trustBar.map((it) => (
            <div class="rounded border border-industrial-300 border-l-[3px] border-l-amber-400 bg-industrial-100 p-5">
              <span
                class="mb-3 grid h-11 w-11 place-items-center rounded bg-white text-amber-700 ring-1 ring-industrial-300"
                aria-hidden="true"
              >
                {it.icon === 'warehouse' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-6 w-6">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 11.5 12 4l9 7.5M5.25 9.75V19c0 .55.45 1 1 1H9.5v-4.25c0-.55.45-1 1-1h3c.55 0 1 .45 1 1V20h3.25c.55 0 1-.45 1-1V9.75"
                    />
                  </svg>
                )}
                {it.icon === 'shield' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-6 w-6">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12.75 11.25 15 15 9.75M12 3l7.5 3v5.25c0 4.28-2.96 8.29-7.5 9.75-4.54-1.46-7.5-5.47-7.5-9.75V6L12 3z"
                    />
                  </svg>
                )}
                {it.icon === 'recycle' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-6 w-6">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M16.023 9.348h4.992V4.356M3.985 15.653H8.977v4.992M4.031 9.75a8.25 8.25 0 0 1 13.803-3.7L21 9m-1.031 5.25a8.25 8.25 0 0 1-13.803 3.7L3 15"
                    />
                  </svg>
                )}
                {it.icon === 'truck' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-6 w-6">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375c-.621 0-1.125-.504-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-2.25m-16.5-3.75h13.5m-13.5 0V6.375c0-.621.504-1.125 1.125-1.125h9.75c.621 0 1.125.504 1.125 1.125v3.75m0 0h2.25l2.25 2.25v2.25M14.25 10.5v6.75"
                    />
                  </svg>
                )}
              </span>
              <dt class="font-heading font-semibold text-charcoal">{it.term}</dt>
              <dd class="mt-1.5 text-sm text-charcoal-600">{it.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Section 3: Product Hub Overview */}
  <section aria-labelledby="product-hubs-h" class={`${sectionShell} bg-industrial-100`}>
    <div class={container}>
      <h2 id="product-hubs-h" class={h2}>Engineered Rubber Solutions for Every Application</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-3">
        {
          productHubs.map((hub) => (
            <li class="flex flex-col rounded border border-industrial-300 bg-white p-6 shadow-card">
              <h3 class="font-heading text-lg font-bold text-charcoal">{hub.title}</h3>
              <p class="mt-2 flex-1 text-sm text-charcoal-600">{hub.body}</p>
              <p class="mt-4 text-sm">
                <strong class="font-semibold text-charcoal">Core Products:</strong>{' '}
                <span class="text-charcoal-600">{hub.products.join(', ')}</span>
              </p>
              <a
                href={hub.href}
                class="mt-4 inline-flex items-center gap-1 rounded text-sm font-semibold text-amber-700 hover:text-amber-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-700"
              >
                {hub.anchor}
                <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Section 4: Problem & Solution */}
  <section aria-labelledby="challenges-h" class={`${sectionShell} bg-white`}>
    <div class={container}>
      <h2 id="challenges-h" class={h2}>Solving Structural &amp; Flooring Challenges in the Middle East</h2>
      <p class={lede}>
        Operating facilities in the GCC presents harsh environmental and structural demands. Rukn
        Al Zain provides engineered rubber solutions designed to solve these issues directly:
      </p>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        {
          challenges.map((c) => (
            <div class="rounded border border-industrial-300 bg-industrial-100 p-6">
              <p class="text-xs font-semibold uppercase tracking-wide text-charcoal-500">Challenge</p>
              <p class="mt-1.5 font-heading font-semibold text-charcoal">{c.challenge}</p>
              <p class="mt-2 text-sm text-charcoal-600">{c.challengeDesc}</p>
              <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-amber-700">Solution</p>
              <p class="mt-1.5 text-sm text-charcoal-600">{c.solutionDesc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Section 5: Key Product Benefits */}
  <section aria-labelledby="benefits-h" class={`${sectionShell} bg-industrial-100`}>
    <div class={container}>
      <h2 id="benefits-h" class={h2}>Built for Performance, Safety, and Longevity</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          benefits.map((b, i) => (
            <li class="flex gap-4 rounded border border-industrial-300 bg-white p-5">
              <span
                class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-amber-400 font-heading text-sm font-bold text-charcoal-900"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div>
                <h3 class="font-heading text-base font-bold text-charcoal">{b.term}</h3>
                <p class="mt-1 text-sm text-charcoal-600">{b.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Section 6: Technical Specifications */}
  <section aria-labelledby="specs-h" class={`${sectionShell} bg-white`}>
    <div class={container}>
      <h2 id="specs-h" class={h2}>Universal Material Performance Standards</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[32rem] border-collapse text-left text-sm tabular-nums">
          <caption class="sr-only">Rukn Al Zain universal material performance standards</caption>
          <thead>
            <tr class="border-b-2 border-charcoal-300 bg-industrial-100">
              <th scope="col" class="px-4 py-3 font-semibold text-charcoal">Specification</th>
              <th scope="col" class="px-4 py-3 font-semibold text-charcoal">Standard Rating / Metric</th>
            </tr>
          </thead>
          <tbody>
            {
              specRows.map((row, i) => (
                <tr class:list={['border-b border-industrial-300', i % 2 === 1 && 'bg-industrial-100']}>
                  <th scope="row" class="px-4 py-3 align-top font-semibold text-charcoal">{row[0]}</th>
                  <td class="px-4 py-3 align-top text-charcoal-600">{row[1]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* Section 7: Ideal Applications Across the UAE */}
  <section aria-labelledby="applications-h" class={`${sectionShell} bg-industrial-100`}>
    <div class={container}>
      <h2 id="applications-h" class={h2}>Ideal Applications Across the UAE</h2>
      <dl class="mt-8 grid gap-5 sm:grid-cols-2">
        {
          applications.map((a) => (
            <div class="rounded border border-industrial-300 bg-white p-5">
              <dt class="font-heading font-semibold text-charcoal">{a.term}</dt>
              <dd class="mt-1.5 text-sm text-charcoal-600">{a.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Section 8: About Rukn Al Zain */}
  <section aria-labelledby="about-h" class={`${sectionShell} bg-white`}>
    <div class={container}>
      <h2 id="about-h" class={h2}>Why Rukn Al Zain?</h2>
      <p class={lede}>
        Rukn Al Zain General Trading LLC is a premier UAE supplier of recycled rubber flooring,
        acoustic underlays, and equine matting. We partner with contractors, fit-out firms,
        fitness owners, and farm operators to supply high-durability surfaces engineered for GCC
        conditions.
      </p>

      <h3 class="mt-10 font-heading text-lg font-bold text-charcoal">Core Brand Values</h3>
      <dl class="mt-5 grid gap-5 sm:grid-cols-3">
        {
          brandValues.map((v) => (
            <div class="rounded border border-industrial-300 border-l-[3px] border-l-amber-400 bg-industrial-100 p-5">
              <dt class="font-heading font-semibold text-charcoal">{v.term}</dt>
              <dd class="mt-1.5 text-sm text-charcoal-600">{v.desc}</dd>
            </div>
          ))
        }
      </dl>

      <h3 class="mt-12 font-heading text-lg font-bold text-charcoal">Our Simple 4-Step Process</h3>
      <ol class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map(([step, desc], i) => (
            <li class="rounded border border-industrial-300 bg-white p-5">
              <span
                class="grid h-8 w-8 place-items-center rounded-full bg-amber-400 font-heading text-sm font-bold text-charcoal-900"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <p class="mt-3 font-heading font-semibold text-charcoal">{step}</p>
              <p class="mt-1.5 text-sm text-charcoal-600">{desc}</p>
            </li>
          ))
        }
      </ol>

      <h3 class="mt-12 font-heading text-lg font-bold text-charcoal">Express Delivery Across the UAE</h3>
      <dl class="mt-5 grid gap-5 sm:grid-cols-2">
        {
          deliveryAreas.map((d) => (
            <div class="rounded border border-industrial-300 bg-industrial-100 p-5">
              <dt class="font-heading font-semibold text-charcoal">{d.term}</dt>
              <dd class="mt-1.5 text-sm text-charcoal-600">{d.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Section 9: FAQ — visible Q&A + FAQPage JSON-LD via shared component */}
  <Faq faqs={faqs} heading="Frequently Asked Questions" id="homepage-faq" />

  {/* Section 10: Lead Capture & Project Quote Form */}
  <section id="request-quote" aria-labelledby="request-quote-h" class="border-t border-industrial-300 bg-charcoal-700 text-white">
    <div class={`${container} py-16`}>
      <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
        <div>
          <h2 id="request-quote-h" class="text-2xl font-bold text-white">Request a Free Sample or Quote</h2>
          <p class="mt-4 max-w-md text-industrial-200">
            Fill out the form below to receive a custom quote or request physical product samples
            delivered to your site.
          </p>

          <dl class="mt-6 space-y-3 text-sm">
            <div class="flex flex-wrap gap-x-2">
              <dt class="font-semibold text-white">Phone / WhatsApp:</dt>
              <dd>
                <a
                  href="tel:+971505698195"
                  class="rounded font-medium text-amber-400 hover:text-amber-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
                >
                  +971 50 569 8195
                </a>
              </dd>
            </div>
            <div class="flex flex-wrap gap-x-2">
              <dt class="font-semibold text-white">Location:</dt>
              <dd class="text-industrial-200">Dubai, United Arab Emirates (P.O. Box 36528)</dd>
            </div>
          </dl>

          <a
            href="https://wa.me/971505698195?text=Hello%20Rukn%20Al%20Zain%2C%20I%20have%20an%20inquiry%20regarding%20your%20rubber%20flooring%20products."
            target="_blank"
            rel="noopener"
            class={`${whatsappCta} mt-6`}
          >
            WhatsApp Now (+971 50 569 8195)
          </a>
        </div>

        {/*
          Netlify form. TODO: Missing spec from brief — confirm CRM/email
          routing, success page and privacy policy link (CLAUDE.md §6).
        */}
        <form
          name="homepage-quote"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/contact?submitted=true"
          class="rounded border border-white/15 bg-charcoal-800 p-6"
        >
          <input type="hidden" name="form-name" value="homepage-quote" />
          <p class="hidden">
            <label>
              Do not fill this out if you are human: <input name="bot-field" />
            </label>
          </p>

          <fieldset class="m-0 space-y-4 border-0 p-0">
            <legend class="mb-2 font-heading text-lg font-semibold text-white">
              Request Free Sample &amp; Quote
            </legend>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="lf-name" class="block text-sm font-medium text-industrial-100">Full Name *</label>
                <input
                  id="lf-name"
                  name="name"
                  type="text"
                  placeholder="e.g. Ahmed Al Mansoori"
                  autocomplete="name"
                  required
                  class="mt-1 w-full rounded border border-charcoal-300 bg-white px-3 py-2 text-charcoal placeholder:text-charcoal-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
                />
              </div>

              <div>
                <label for="lf-phone" class="block text-sm font-medium text-industrial-100">Phone / WhatsApp Number *</label>
                <input
                  id="lf-phone"
                  name="phone"
                  type="tel"
                  placeholder="+971 50 000 0000"
                  autocomplete="tel"
                  required
                  class="mt-1 w-full rounded border border-charcoal-300 bg-white px-3 py-2 text-charcoal placeholder:text-charcoal-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
                />
              </div>

              <div>
                <label for="lf-emirate" class="block text-sm font-medium text-industrial-100">Project Location (Emirate) *</label>
                <select
                  id="lf-emirate"
                  name="emirate"
                  required
                  class="mt-1 w-full rounded border border-charcoal-300 bg-white px-3 py-2 text-charcoal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
                >
                  <option value="" selected>Select Emirate</option>
                  {emirates.map((e) => <option value={e}>{e}</option>)}
                </select>
              </div>

              <div>
                <label for="lf-area" class="block text-sm font-medium text-industrial-100">Required Area (Sq. Meters)</label>
                <input
                  id="lf-area"
                  name="required-sq-meters"
                  type="number"
                  min="1"
                  inputmode="numeric"
                  placeholder="e.g. 250"
                  class="mt-1 w-full rounded border border-charcoal-300 bg-white px-3 py-2 text-charcoal tabular-nums placeholder:text-charcoal-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
                />
              </div>
            </div>

            <div>
              <label for="lf-details" class="block text-sm font-medium text-industrial-100">Product Category &amp; Details *</label>
              <textarea
                id="lf-details"
                name="product-details"
                rows="4"
                placeholder="Mention product type (e.g., Gym Tiles, Acoustic Screed Underlay, Stable Mats) or detail your free sample request..."
                required
                class="mt-1 w-full rounded border border-charcoal-300 bg-white px-3 py-2 text-charcoal placeholder:text-charcoal-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full rounded bg-amber-400 px-5 py-3 font-semibold text-charcoal-900 transition-colors hover:bg-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal-800"
            >
              Request Free Sample &amp; Quote
            </button>
          </fieldset>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
