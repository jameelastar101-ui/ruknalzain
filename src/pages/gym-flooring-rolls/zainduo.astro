<BaseLayout
  title="ZainDuo Performance Gym Flooring Dubai | Roll + Tile System | Rukn Al Zain"
  description="ZainDuo combines a performance rubber roll surface with an SBR tile base for maximum shock absorption in Dubai commercial and home gyms."
  canonical={PATH}
  ogImage={OG_IMG}
  ogImageAlt="ZainDuo dual-layer EPDM roll and SBR tile-base performance gym flooring system by Rukn Al Zain, Dubai UAE."
>
  <article class="zd-page">
    {/*
      Mark the document as JS-capable ASAP so scroll-reveal elements start hidden
      only when the animation engine is available. A failsafe timer guarantees
      content becomes visible even if the observer below never runs, and
      reduced-motion visitors skip the effect entirely.
    */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('zd-js');
        var sel = '.zd-page [data-reveal], .zd-page [data-reveal-group]';
        var showAll = function () {
          document.querySelectorAll(sel).forEach(function (el) {
            el.classList.add('in');
          });
        };
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', showAll);
          else showAll();
