    {/* ─── SUBTLE MOTION ──────────────────────────────────────────────────────
        A one-shot load-in for the hero (pure CSS, cannot get stuck hidden) and a
        staggered scroll-reveal (fade + short rise) for headings, card groups,
        figures, the spec table and the FAQ. Plus a small hover lift on cards.
        Progressive enhancement only — content is fully visible without JS, and
        every effect is disabled under prefers-reduced-motion. */}
    <style is:global>
      .gsa-js .gsa-page [data-hero] {
        animation: gsa-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes gsa-rise {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
      }

      .gsa-js .gsa-page [data-reveal],
      .gsa-js .gsa-page [data-reveal-group] > * {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .gsa-js .gsa-page [data-reveal].in,
      .gsa-js .gsa-page [data-reveal-group].in > * {
        opacity: 1;
        transform: none;
      }
      .gsa-js .gsa-page [data-reveal-group].in > *:nth-child(2) { transition-delay: 0.06s; }
      .gsa-js .gsa-page [data-reveal-group].in > *:nth-child(3) { transition-delay: 0.12s; }
      .gsa-js .gsa-page [data-reveal-group].in > *:nth-child(4) { transition-delay: 0.18s; }
      .gsa-js .gsa-page [data-reveal-group].in > *:nth-child(5) { transition-delay: 0.24s; }
      .gsa-js .gsa-page [data-reveal-group].in > *:nth-child(6) { transition-delay: 0.30s; }
      .gsa-js .gsa-page [data-reveal-group].in > *:nth-child(n + 7) { transition-delay: 0.36s; }

      .gsa-page .card-lift {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      .gsa-page .card-lift:hover {
        transform: translateY(-3px);
      }

      @media (prefers-reduced-motion: reduce) {
        .gsa-js .gsa-page [data-hero] {
          animation: none;
        }
        .gsa-js .gsa-page [data-reveal],
        .gsa-js .gsa-page [data-reveal-group] > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .gsa-page .card-lift,
        .gsa-page .card-lift:hover,
        .gsa-page .bestfor-card,
        .gsa-page .bestfor-card:hover {
          transition: none;
          transform: none;
        }
      }
    </style>

    <script>
      const targets = document.querySelectorAll(
        '.gsa-page [data-reveal], .gsa-page [data-reveal-group]',
      );
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealAll = () => targets.forEach((el) => el.classList.add('in'));

      if (reduce || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
        window.addEventListener('load', () => setTimeout(revealAll, 1200));
      }
    </script>
