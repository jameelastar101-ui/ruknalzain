<BaseLayout
  title="Rubber Curb Stones UAE | Gym Equipment Protection | Rukn Al Zain"
  description="Zain Curb Stones absorb impact and protect glass, mirrors and equipment from accidental weight drops in commercial and home gyms across Dubai and UAE."
  canonical="/gym-safety-accessories"
  ogImage={HERO_IMG}
  ogImageAlt={HERO_ALT}
>
  <article class="gsa-page">
    {/*
      Set a marker class ASAP so scroll-reveal elements start hidden only when JS
      is running (no-JS visitors always get fully rendered content). A failsafe
      timer guarantees everything becomes visible even if the observer module
      below never executes, and reduced-motion users skip the effect entirely.
    */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('gsa-js');
        var sel = '.gsa-page [data-reveal], .gsa-page [data-reveal-group]';
        var showAll = function () {
          document.querySelectorAll(sel).forEach(function (el) {
            el.classList.add('in');
          });
        };
        var reduce =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', showAll);
          else showAll();
        } else {
          setTimeout(showAll, 1600);
        }
      })();
    </script>

    {/* Breadcrumb strip — Home > Gym & Fitness Flooring > Gym Safety Accessories */}
